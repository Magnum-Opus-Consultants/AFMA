@model AFMA.ApplicationLayer.Model.Wims.MemberModel
@using AFMA.ApplicationLayer.ViewModels
@using AFMA.Web.Admin.Helpers
@using Microsoft.CodeAnalysis.Operations

@{
  bool tabActive = true;
  bool canEdit = await WimsApplicationLayer.CanUserEditMember(Model.Id).ConfigureAwait(false);
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Member Management</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Member</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">View Member</h3>

  <ul class="nav nav-pills pl-3" id="memberTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="true">Details</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="branches-tab" data-bs-toggle="tab" data-bs-target="#branches" type="button" role="tab" aria-controls="branches" aria-selected="false">Branches</button>
    </li>
@*     <li class="nav-item" role="presentation">
      <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab" aria-controls="documents" aria-selected="false">Documents</button>
    </li>
 *@    <li class="nav-item" role="presentation">
      <button class="nav-link" id="committees-tab" data-bs-toggle="tab" data-bs-target="#committees" type="button" role="tab" aria-controls="committees" aria-selected="false">Committees</button>
    </li>
@*     <li class="nav-item" role="presentation">
      <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab" aria-controls="users" aria-selected="false">Users</button>
    </li>
 *@
  </ul>
  <div class="tab-content pt-3" id="myTabContent">
    <div class="tab-pane fade show active" id="details" role="tabpanel" aria-labelledby="details-tab">
      <p>Manages all member related information</p>
      <div class="row g-2">
        <div class="col-12">
          <div class="card">
            <div class="card-body">

              <div class="row mt-2">
                <div class="col-6">
                  <div class="form-group">
                    <label asp-for="MemberType" class="form-label"></label>
                    <input asp-for="MemberType" class="form-control" disabled />
                  </div>
                </div>

                <div class="col-6">
                  <div class="form-group">
                    <label asp-for="MemberIdentificationId" class="form-label"></label>
                    <input asp-for="MemberIdentificationId" class="form-control" disabled />
                  </div>
                </div>

              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberTradeName" class="form-label"></label>
                    <input asp-for="MemberTradeName" class="form-control" disabled />
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberLegalName" class="form-label"></label>
                    <input asp-for="MemberLegalName" class="form-control" disabled />
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="RegistrationNo" class="form-label"></label>
                    <input asp-for="RegistrationNo" class="form-control" disabled />
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="VatRegistrationNo" class="form-label"></label>
                    <input asp-for="VatRegistrationNo" class="form-control" disabled />
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberOtherName" class="form-label"></label>
                    <input asp-for="MemberOtherName" class="form-control" disabled />
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Province" class="form-label"></label>
                    <input asp-for="Province" class="form-control" disabled />
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="PhysicalAddress" class="form-label"></label>
                    <textarea asp-for="PhysicalAddress" class="form-control" rows="3" disabled></textarea>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="PostalAddress" class="form-label"></label>
                    <textarea asp-for="PostalAddress" class="form-control" rows="3" disabled></textarea>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="TelephoneNo" class="form-label"></label>
                    <input asp-for="TelephoneNo" class="form-control" disabled />
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Website" class="form-label"></label>
                    <input asp-for="Website" class="form-control" disabled />
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="GpsCoordinates" class="form-label"></label>
                    <input asp-for="GpsCoordinates" class="form-control" disabled />
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Active" class="form-label"></label>
                    <input class="form-control" disabled value="@(Model.Active ? "Active" : "Inactive")" />
                  </div>
                </div>
              </div>


              <div style="float: left" class="mt-4">
                <a asp-controller="Member" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
              </div>

              <div style="float: right" class="mt-4">
                @if (@canEdit)
                {
                  <a asp-controller="Member" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
                }
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="tab-pane fade" id="branches" role="tabpanel" aria-labelledby="branches-tab">
      <div class="row g-2">
        <div class="col-md-12">
          <p>Manages all branches for the selected member</p>

@*           <div class="card">
            <div class="card-body">
 *@              <div class="row">

                @foreach (var branch in Model.Branches)
                {
                  <div class="col-3 col-lg-3 pb-3">
                    <div class="card">
                      <div class="card-body">
                        <h4 class="card-title mb-3"><i class="fa fa-location-dot"></i> @branch.BranchName</h4>
                        <div class="card-text"><strong>Province:</strong> @branch.Province</div>
                        <div class="card-text"><strong>Animal Feed Products:</strong> @branch.AnimalFeedProducts.Count</div>
                        <div class="card-text"><strong>Contacts:</strong> @branch.Contacts.Count</div>
                        <div class="card-text"><strong>Telephone No:</strong> @branch.TelephoneNumber</div>
                        <div style="float: right" class="mt-2">
                          <a asp-controller="Member" asp-action="DetailsBranch" asp-route-id="@branch.Id" class="btn btn-afm-primary btn-sm"><i class="fa-solid fa-eye"></i> View</a>
                        </div>
                      </div>
                    </div>
                  </div>
                }

@*               </div>
            </div>
 *@          </div>

        </div>
      </div>
    </div>
@*     <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
      <div class="row g-2">
        <div class="col-md-12">
          <p>Manages all documentation and downloads for the selected member</p>
          <div class="col-12 pb-2">
            <a asp-controller="Member" asp-action="CreateDocument" asp-route-memberId="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
