@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.MemberUserDistributionGroupModel>
@using AFMA.ApplicationLayer.ViewModels
@using AFMA.Web.Admin.Helpers
@using Microsoft.CodeAnalysis.Operations

@{
  var distributionGroups = await WimsApplicationLayer.GetPublicDistributionGroups().ConfigureAwait(false);
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Communication</a></li>
    <li class="breadcrumb-item active" aria-current="page">Distribution Groups</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Distribution Groups</h3>
  <p>Select all the email groups you want to be part of. The email address linked to your profile will be used to send the communication to</p>
  <div class="card">
    <div class="card-body">
      <form class="needs-validation" novalidate asp-action="Index" method="post">
        <div class="table-responsive">
        <table class="table table-striped table-sm table-bordered">
          <thead>
            <tr>
              <th scope="col" class="w-5"></th>
              <th scope="col" class="w-25">Group Name</th>
              <th scope="col" class="w-50">Group Description</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in distributionGroups)
            {
              var isSelected = Model.Any(x => x.DistributionGroupId == item.Id) ? "checked" : "";

              <tr>
                <td class="align-middle text-center">
                  <input class="form-check-input me-1 p-2" type="checkbox" id="dg_@item.Id" name="dg_@item.Id" @isSelected>
                </td>
                <td class="align-middle">
                  @item.Name
                </td>
                <td class="align-middle">
                  @item.Description
                </td>
              </tr>
            }
          </tbody>
        </table>

        <div style="float: right" class="mt-3">
          <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
          <a asp-area="Profile" asp-controller="Distribution" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
        </div>

      </div>
      </form>
    </div>
  </div>
</div>