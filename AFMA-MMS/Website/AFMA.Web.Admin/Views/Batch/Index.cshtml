@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.BatchModel>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Communication</a></li>
    <li class="breadcrumb-item active" aria-current="page">Email Batches</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Email Batches</h3>
  <p>Manages all bulk communications</p>
  <div class="card">
    <div class="card-body">
      <div class="col-12 pb-3">
        <a asp-controller="Batch" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-sm table-bordered">
          <thead>
          <tr>
            <th scope="col" class="w-5">Batch No</th>
            <th scope="col" class="w-25">Description</th>
            <th scope="col" class="w-5">Created</th>
            <th scope="col" class="w-5">Submitted</th>
            <th scope="col" class="w-5">Status</th>
            <th scope="col" class="w-5">Recipients</th>
            <th class="w-5"></th>
          </tr>
          </thead>
          <tbody>
            @foreach (var item in Model)
            {
              <tr>
              <td class="align-middle">@item.Id</td>
              <td class="align-middle">@item.Description</td>
              <td class="align-middle text-center">@item.CreatedDate</td>
              <td class="align-middle text-center">@item.SubmissionDate</td>
              <td class="align-middle text-center">@item.Status</td>
              <td class="align-middle text-center">@item.RecipientCount</td>
              <td class="text-center">
                <a asp-action="Details" asp-controller="Batch" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
              </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>