@using AFMA.ApplicationLayer.Helpers
@model AFMA.ApplicationLayer.Model.Wims.CommitteeDocumentModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Committee Document</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Edit Committee Document</h3>
  <p>Manages committees related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="EditDocument" method="post" enctype="multipart/form-data">

            <input asp-for="CommitteeId" type="hidden" />

            <div class="row mt-2">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="DocumentTypeId" class="form-label"></label>
                  <select class="form-control" asp-for="DocumentTypeId" asp-items="await WimsApplicationLayer.GenerateDocumentTypeSelectList(Model.DocumentTypeId)"></select>
                  <span asp-validation-for="DocumentTypeId"></span>
                </div>
              </div>
            </div>

            <div class="row mt-4">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="Name" class="form-label"></label>
                  <input asp-for="Name" class="form-control" />
                  <span asp-validation-for="Name"></span>
                </div>
              </div>
            </div>
            
            <div class="row mt-4">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="Description" class="form-label"></label>
                  <textarea rows="3" asp-for="Description" class="form-control"></textarea>
                  <span asp-validation-for="Description"></span>
                </div>
              </div>
            </div>

            <div class="row mt-4">
              <div class="col-12">
                <div class="alert alert-primary d-flex" role="alert">
                  <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                  <div class="ms-3">
                    <h6 class="text-reset">Important!</h6>
                    To upload a new document for this member document simply browse for the document on your computer below, or to keep the current document, simply leave this blank.
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="DocumentContent" class="form-label"></label>
                  <input asp-for="DocumentContent" class="form-control" type="file">
                  <span asp-validation-for="DocumentContent"></span>
                </div>
              </div>
            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="Committee" asp-action="Details" asp-route-id="@Model.CommitteeId" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="~/js/max-file-size-validation.js"></script>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}