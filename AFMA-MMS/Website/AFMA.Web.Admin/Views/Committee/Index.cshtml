@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.CommitteeModel>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Members</a></li>
    <li class="breadcrumb-item active" aria-current="page">Committees</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Committees</h3>
  <p>Manages all committees and related information</p>
  <div class="card">
    <div class="card-body">
      <div class="col-12 pb-3">
        <a asp-controller="Committee" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-sm table-bordered">
          <thead>
          <tr>
            <th scope="col" class="w-25">Name</th>
            <th scope="col" class="w-5">Members</th>
            <th scope="col" class="w-5">Documents</th>
            <th class="w-5"></th>
          </tr>
          </thead>
          <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td class="align-middle">
                @item.Name
              </td>
              <td class="align-middle">
                @item.Members.Count
              </td>
              <td class="align-middle">
                @item.Documents.Count
              </td>
              <td class="text-center">
                <a asp-action="Details" asp-controller="Committee" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>