@model AFMA.ApplicationLayer.Model.Wims.CommitteeModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Members</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Committee</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">View Committee</h3>
  <p>Manages all committees and related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <div class="row mt-2">
            <div class="col-12">
              <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" disabled />
              </div>
            </div>
          </div>

          <div style="float: left" class="mt-4">
            <a asp-controller="Committee" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
          </div>

          <div style="float: right" class="mt-4">
            <a asp-controller="Committee" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
            <a asp-controller="Committee" asp-action="Export" asp-route-id="@Model.Id" class="btn btn-afm-secondary"><i class="fa-solid fa-file-excel-o"></i> Export</a>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteCommittee"><i class="fa-solid fa-trash"></i> Delete</button>
          </div>

        </div>
      </div>
    </div>
  </div> 

  <hr />

  <div class="col-md-12">
    <h3 class="fw-black">Members</h3>
    <div class="card">
      <div class="card-body">

        <div class="row g-2">
          <div class="col-12 pb-2">
            <a asp-controller="Committee" asp-action="CreateMember" asp-route-committeeId="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
          </div>

          <div class="table-responsive">
            <table class="table table-striped table-sm table-bordered">
              <thead>
              <tr>
                  <th scope="col" class="w-15">Contact Name</th>
                <th scope="col" class="w-15">Member</th>
                <th scope="col" class="w-15">Email Address</th>
                <th class="w-1"></th>
                <th class="w-10"></th>
              </tr>
              </thead>
              <tbody>
              @foreach (var item in Model.Members)
              {
                <tr>
                  <td class="align-middle">
                    @item.Name
                  </td>
                  <td class="align-middle">
                    @item.MemberName
                  </td>
                  <td class="align-middle">
                    @item.EmailAddress
                  </td>
                  <td class="align-middle text-center">
                    @if (item.MemberBranchContactId.HasValue)
                    {
                      <i class="fa fa-2x @(item.MemberBranchContactMatch ? "fa-check-circle text-success" : "fa-exclamation-triangle text-danger")" 
                      title="@(item.MemberBranchContactMatch ? "The committee member details match the branch contact." : "The committee member details do not match the branch contact.")"></i>
                    }
                  </td>
                    <td class="text-center">
                    <a asp-action="EditMember" asp-controller="Committee" asp-route-id="@item.Id" asp-route-match="@item.MemberBranchContactMatch" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> Edit</a>
                      <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteCommitteeMember" onclick="$('#deleteMemberId').val('@item.Id');"><i class="fa-solid fa-trash"></i> Remove</button>
                  </td>
                </tr>
              }
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <hr />
    <div class="col-md-12">
      <h3 class="fw-black">Documents</h3>
      <div class="card">
        <div class="card-body">

          <div class="row g-2">
            <div class="col-12 pb-2">
              <a asp-controller="Committee" asp-action="CreateDocument" asp-route-committeeId="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
            </div>

            <div class="table-responsive">
              <table class="table table-striped table-sm table-bordered">
                <thead>
                  <tr>
                    <th scope="col" class="w-15">Name</th>
                    <th scope="col" class="w-15">Document Type</th>
                    <th scope="col" class="w-15">Document Format</th>
                    <th class="w-10"></th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var item in Model.Documents)
                  {
                    <tr>
                      <td class="align-middle">
                        @item.Name
                      </td>
                      <td class="align-middle">
                        @item.DocumentType
                      </td>
                      <td class="align-middle">
                        @item.DocumentContentType
                      </td>
                      <td class="text-center">
                      <a asp-action="DownloadDocument" asp-controller="Committee" asp-route-id="@item.Id" class="btn btn-afm-secondary btn-sm"><i class="fa-solid fa-download"></i> Download</a>
                        <a asp-action="EditDocument" asp-controller="Committee" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> Edit</a>
                      <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteCommitteeDocument" onclick="$('#deleteDocumentId').val('@item.Id');"><i class="fa-solid fa-trash"></i> Remove</button>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>

<partial name="Delete" model='new DeleteViewModel { Id = Model.Id }' />
<partial name="DeleteCommitteeDocument" model='new DeleteViewModel { ParentId = Model.Id }' />
<partial name="DeleteCommitteeMember" model='new DeleteViewModel { ParentId = Model.Id }' />

<script>
  $('#deleteCommitteeDocument').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var documentId = button.data('id');

      $('#deleteDocumentId').val(documentId);
  });

  $('#deleteCommitteeMember').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var memberId = button.data('id');

      $('#deleteMemberId').val(memberId);
  });
</script>