@model AFMA.ApplicationLayer.Model.Wims.DocumentTypeModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Document Type</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Edit Document Type</h3>
  <p>Manages document types related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="Edit" method="post">

            <div class="row mt-2">
              <div class="col-8">
                <div class="form-group">
                  <label asp-for="Description" class="form-label"></label>
                  <input asp-for="Description" class="form-control" />
                  <span asp-validation-for="Description"></span>
                </div>
              </div>

              <div class="col-4">
                <div class="form-group">
                  <label asp-for="DocumentTemplateId" class="form-label"></label>
                  <select id="DocumentTemplateId" name="DocumentTemplateId" class="form-control" asp-items="@(await WimsApplicationLayer.GenerateDocumentTemplateSelectList(Model.DocumentTemplateId))">
                    <option value="">-- Select Document Template --</option>
                  </select>
                  <span asp-validation-for="DocumentTemplateId"></span>
                </div>
              </div>
            </div>

            <div class="row mt-3">
              <div class="col-12 mt-2">
                <div class="form-group">
                  <input asp-for="RequireTemplate" class="form-check-input" type="checkbox">
                  <label asp-for="RequireTemplate" class="form-check-label">Requires Template</label>
                </div>
              </div>
            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="DocumentType" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}