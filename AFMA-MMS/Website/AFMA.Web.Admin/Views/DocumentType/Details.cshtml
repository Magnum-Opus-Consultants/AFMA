@model AFMA.ApplicationLayer.Model.Wims.DocumentTypeModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Document Types</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">View Document Types</h3>
  <p>Manages all document types and related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <div class="row mt-2">
            <div class="col-8">
              <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" disabled />
              </div>
            </div>
            
            <div class="col-4">
              <div class="form-group">
                <label asp-for="DocumentTemplate" class="form-label"></label>
                <input asp-for="DocumentTemplate" class="form-control" disabled />
              </div>
            </div>
            
            <div class="row mt-3">
              <div class="col-12 mt-2">
                <div class="form-group">
                  <input asp-for="RequireTemplate" class="form-check-input" type="checkbox" disabled>
                  <label asp-for="RequireTemplate" class="form-check-label">Require Template</label>
                </div>
              </div>
            </div>
          </div>

          <div style="float: left" class="mt-4">
            <a asp-controller="DocumentType" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
          </div>

          <div style="float: right" class="mt-4">
            <a asp-controller="DocumentType" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteDocumentType"><i class="fa-solid fa-trash"></i> Delete</button>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<partial name="Delete" model='new DeleteViewModel { Id = Model.Id }' />