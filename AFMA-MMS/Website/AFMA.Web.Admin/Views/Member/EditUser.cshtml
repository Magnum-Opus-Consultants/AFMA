@model AFMA.ApplicationLayer.Model.Wims.MemberUserModel

<link href="~/css/flatpickr.min.css" rel="stylesheet" />

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Member Management</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit User</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Edit Member User</h3>
  <p>Manages all member related information</p>
  <form class="needs-validation" novalidate asp-action="EditUser" method="post">
    
    <input type="hidden" asp-for="Id" />
    
    <div class="row g-2">

      <div class="col-8">
        <div class="card">
          <div class="card-body">
            <div class="row mt-2">
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="FirstName" class="form-label"></label>
                  <input asp-for="FirstName" class="form-control" />
                  <span asp-validation-for="FirstName"></span>
                </div>
              </div>
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="LastName" class="form-label"></label>
                  <input asp-for="LastName" class="form-control" />
                  <span asp-validation-for="LastName"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="Email" class="form-label"></label>
                  <input asp-for="Email" class="form-control" />
                  <span asp-validation-for="Email"></span>
                </div>
              </div>

              <div class="col-3 mt-2">
                  <label asp-for="CanEdit" class="form-label"></label>
                  <select class="form-control" asp-for="CanEdit" asp-items="@WimsApplicationLayer.GenerateYesNoList(Model.CanEdit)"></select>
                </div>
                <div class="col-3 mt-2">
                  <label asp-for="IsActive" class="form-label"></label>
                  <select class="form-control" asp-for="IsActive" asp-items="@WimsApplicationLayer.GenerateActiveInactiveList(Model.IsActive)"></select>
                </div>
              </div>

              <div style="float: right" class="mt-4">
                <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
                <a asp-controller="Member" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
              </div>


          </div>
        </div>
      </div>
      <div class="col-4">
        <div class="card">
          <div class="card-body">
            @await Html.PartialAsync("MemberUserBranchPartial", Model.MemberBranches)
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script src="~/vendor/flatpickr/flatpickr.min.js"></script>

<script>
  flatpickr('.datepicker')
</script>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}