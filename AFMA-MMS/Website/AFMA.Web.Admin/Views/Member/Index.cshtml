@using AFMA.ApplicationLayer.Helpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using X.PagedList.Mvc.Core
@using X.PagedList
@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.MemberModel>

@{
  var filterMemberTypeId = Context.Request.Query["filterMemberTypeId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
  var filterProvinceId = Context.Request.Query["filterProvinceId"].ToNullableInt();
  var filterMemberStatusId = Context.Request.Query["filterMemberStatusId"].ToNullableBool();
  var filterMemberStatusValue = Context.Request.Query["filterMemberStatusId"].ToString();
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Member Management</a></li>
    <li class="breadcrumb-item active" aria-current="page">Members</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Members</h3>
  <p>Manages all member related information</p>
  <div class="card">
      <div class="card-body">
        <div class="col-12 pb-3">
          <a asp-controller="Member" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
        </div>

      <div class="alert alert-dark">
        <form asp-action="Index" method="get">
          <div class="row g-2">

            <div class="col-4">
              <div class="form-group">
                <label class="form-label">Member Name</label>
                <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search member name or membership number" value="@filterSearchText" />
              </div>
            </div>

            <div class="col-2">
              <div class="form-group">
                <label class="form-label">Province</label>
                <select id="filterProvinceId" name="filterProvinceId" class="form-control" asp-items="@await WimsApplicationLayer.GenerateProvinceSelectList(filterProvinceId)">
                  <option value="">All</option>
                </select>
              </div>
            </div>

            <div class="col-2">
              <div class="form-group">
                <label class="form-label">Member Type</label>
                <select id="filterMemberTypeId" name="filterMemberTypeId" class="form-control" asp-items="@await WimsApplicationLayer.GenerateMemberTypeSelectList(filterMemberTypeId)">
                  <option value="">All</option>
                </select>
              </div>
            </div>

            <div class="col-2">
              <div class="form-group">
                <label class="form-label">Member Status</label>
                <select id="filterMemberStatusId" name="filterMemberStatusId" class="form-control" asp-items="@WimsApplicationLayer.GenerateActiveInactiveList(filterMemberStatusId)">
                  <option value="">All</option>
                </select>
              </div>
            </div>


            <div class="col-2">
              <div class="form-group">
                <label class="form-label">&nbsp;</label><br />
                <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
                <a asp-controller="Member"
                   asp-action="ExportList"
                   asp-route-filterMemberTypeId="@filterMemberTypeId"
                   asp-route-filterProvinceId="@filterProvinceId"
                   asp-route-filterMemberStatusId="@filterMemberStatusValue"
                   asp-route-filterSearchText="@filterSearchText"
                   class="btn btn-afm-default"><i class="fa-solid fa-file-excel-o"></i> Export</a>
              </div>
            </div>

          </div>
        </form>
      </div>

      <div class="table-responsive">
        <div class="mb-3">@Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterMemberTypeId, filterProvinceId, filterMemberStatusId, filterSearchText }))</div>
        <table class="table table-striped table-sm table-bordered">
          <thead>
            <tr>
              <th scope="col" class="w-15">Membership No</th>
              <th scope="col" class="w-25">Member Name</th>
              <th scope="col" class="w-15">Province</th>
              <th scope="col" class="w-25">Member Type</th>
              <th scope="col" class="w-5">Branches</th>
              <th scope="col" class="w-5">Status</th>
              <th class="w-5"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model)
            {
              <tr>
                <td class="align-middle">
                  @item.MemberIdentificationId
                </td>
                <td class="align-middle">
                  @item.MemberLegalName
                </td>
                <td class="align-middle">
                  @item.Province
                </td>
                <td class="align-middle">
                  @item.MemberType
                </td>
                <td class="align-middle text-center">
                  @item.Branches.Count
                </td>
                <td class="align-middle">
                  @Html.Raw(item.Active.ToFormattedMemberStatus())
                </td>

                <td class="text-center">
                  <a asp-action="Details" asp-controller="Member" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
        @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterMemberTypeId, filterProvinceId, filterMemberStatusId, filterSearchText }))
      </div>
    </div>
  </div>
</div>
