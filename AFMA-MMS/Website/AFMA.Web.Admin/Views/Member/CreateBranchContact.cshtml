@model AFMA.ApplicationLayer.Model.Wims.MemberBranchContactModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Member Management</a></li>
    <li class="breadcrumb-item active" aria-current="page">Create Branch Contact</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Create Branch Contact</h3>
  <p>Manages all member related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="CreateBranchContact" method="post">
            
            <input type="hidden" asp-for="MemberId" />
            <input type="hidden" asp-for="MemberBranchId" />

            <div class="row mt-2">
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="MemberContactType" class="form-label"></label>
                  <select class="form-control" asp-for="MemberContactTypeId" asp-items="@await WimsApplicationLayer.GenerateMemberContactTypeSelectList(null)"></select>
                </div>
              </div>
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="Designation" class="form-label"></label>
                  <input asp-for="Designation" class="form-control" />
                  <span asp-validation-for="Designation"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-2 mt-2">
                <div class="form-group">
                  <label asp-for="Title" class="form-label"></label>
                  <input asp-for="Title" class="form-control"/>
                  <span asp-validation-for="Title"></span>
                </div>
              </div>

              <div class="col-5 mt-2">
                <div class="form-group">
                  <label asp-for="FirstName" class="form-label"></label>
                  <input asp-for="FirstName" class="form-control"/>
                  <span asp-validation-for="FirstName"></span>
                </div>
              </div>
              <div class="col-5 mt-2">
                <div class="form-group">
                  <label asp-for="Surname" class="form-label"></label>
                  <input asp-for="Surname" class="form-control"/>
                  <span asp-validation-for="Surname"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-4 mt-2">
                <div class="form-group">
                  <label asp-for="TelephoneNo" class="form-label"></label>
                  <input asp-for="TelephoneNo" class="form-control"/>
                  <span asp-validation-for="TelephoneNo"></span>
                </div>
              </div>
              <div class="col-4 mt-2">
                <div class="form-group">
                  <label asp-for="MobileNo" class="form-label"></label>
                  <input asp-for="MobileNo" class="form-control"/>
                  <span asp-validation-for="MobileNo"></span>
                </div>
              </div>
              <div class="col-4 mt-2">
                <div class="form-group">
                  <label asp-for="EmailAddress" class="form-label"></label>
                  <input asp-for="EmailAddress" class="form-control" />
                  <span asp-validation-for="EmailAddress"></span>
                </div>
              </div>
            </div>
            
            <div class="row mt-2">
              <div class="col-6 mt-2">
                <div class="form-group">
                  <input asp-for="CompanyContact" class="form-check-input" type="checkbox">
                  <label asp-for="CompanyContact" class="form-check-label">Company Wide Contact</label>
                </div>
              </div>
            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="Member" asp-action="DetailsBranch" asp-route-id="@Model.MemberBranchId" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}