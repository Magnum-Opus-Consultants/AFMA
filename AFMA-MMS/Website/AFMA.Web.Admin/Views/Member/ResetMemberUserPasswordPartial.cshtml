@model int

<div class="modal fade" id="resetPasswordConfirm" tabindex="-1" aria-labelledby="resetPasswordConfirm" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Confirm Password Reset</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-id="@Model" asp-controller="Member" asp-action="ResetMemberUserPassword" method="post">
          <div class="row">
            <div class="col-12">
              <div class="form-group">
                <p>Confirm that this user's password will be reset.'</p>
                <p>The new password wll be emailed to the user.</p>
              </div>
            </div>
          </div>
          <div class="row mt-3 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Confirm</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>