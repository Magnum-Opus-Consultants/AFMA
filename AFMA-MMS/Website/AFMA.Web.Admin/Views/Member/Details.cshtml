@model AFMA.ApplicationLayer.Model.Wims.MemberModel
@using AFMA.ApplicationLayer.ViewModels
@using AFMA.ApplicationLayer.ViewModels.Wims
@using AFMA.Web.Admin.Helpers
@using Microsoft.CodeAnalysis.Operations

@{
  bool tabActive = true;
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Member Management</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Member</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">View Member</h3>
  
  <ul class="nav nav-pills pl-3" id="memberTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="true">Details</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="branches-tab" data-bs-toggle="tab" data-bs-target="#branches" type="button" role="tab" aria-controls="branches" aria-selected="false">Branches</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab" aria-controls="documents" aria-selected="false">Documents</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="committees-tab" data-bs-toggle="tab" data-bs-target="#committees" type="button" role="tab" aria-controls="committees" aria-selected="false">Committees</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab" aria-controls="users" aria-selected="false">Users</button>
    </li>

  </ul>
  <div class="tab-content pt-3" id="myTabContent">
    <div class="tab-pane fade show active" id="details" role="tabpanel" aria-labelledby="details-tab">
      <p>Manages all member related information</p>
      <div class="row g-2">
        <div class="col-9">
          <div class="card">
            <div class="card-body">

              <div class="row mt-2">
                <div class="col-6">
                  <div class="form-group">
                    <label asp-for="MemberType" class="form-label"></label>
                    <input asp-for="MemberType" class="form-control" disabled/>
                  </div>
                </div>

                <div class="col-6">
                  <div class="form-group">
                    <label asp-for="MemberIdentificationId" class="form-label"></label>
                    <input asp-for="MemberIdentificationId" class="form-control" disabled/>
                  </div>
                </div>

              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberTradeName" class="form-label"></label>
                    <input asp-for="MemberTradeName" class="form-control" disabled/>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberLegalName" class="form-label"></label>
                    <input asp-for="MemberLegalName" class="form-control" disabled/>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="RegistrationNo" class="form-label"></label>
                    <input asp-for="RegistrationNo" class="form-control" disabled/>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="VatRegistrationNo" class="form-label"></label>
                    <input asp-for="VatRegistrationNo" class="form-control" disabled/>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="MemberOtherName" class="form-label"></label>
                    <input asp-for="MemberOtherName" class="form-control" disabled/>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Province" class="form-label"></label>
                    <input asp-for="Province" class="form-control" disabled/>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="PhysicalAddress" class="form-label"></label>
                    <textarea asp-for="PhysicalAddress" class="form-control" rows="3" disabled></textarea>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="PostalAddress" class="form-label"></label>
                    <textarea asp-for="PostalAddress" class="form-control" rows="3" disabled></textarea>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="TelephoneNo" class="form-label"></label>
                    <input asp-for="TelephoneNo" class="form-control" disabled/>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Website" class="form-label"></label>
                    <input asp-for="Website" class="form-control" disabled/>
                  </div>
                </div>
              </div>

              <div class="row mt-2">
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="GpsCoordinates" class="form-label"></label>
                    <input asp-for="GpsCoordinates" class="form-control" disabled/>
                  </div>
                </div>
                <div class="col-6 mt-2">
                  <div class="form-group">
                    <label asp-for="Active" class="form-label"></label>
                    <input class="form-control" disabled value="@(Model.Active ? "Active" : "Inactive")" />
                  </div>
                </div>
              </div>


              <div style="float: left" class="mt-4">
                <a asp-controller="Member" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
              </div>

              <div style="float: right" class="mt-4">
                <a asp-controller="Member" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
                <a asp-controller="Member" asp-action="Export" asp-route-id="@Model.Id" class="btn btn-afm-default"><i class="fa-solid fa-file-excel-o"></i> Export</a>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteMember"><i class="fa-solid fa-trash"></i> Delete</button>
              </div>

            </div>
          </div>
        </div>

        <div class="col-3">
          <div class="card">
            <div class="card-body">
              <h5>Synchronization Status</h5>
              <p>Sync status with stats system</p>
              <table class="table-sm">
                <thead>
                <tr>
                  <th>Section</th>
                  <th class="text-center" style="width:80%">Status</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                  <td>Member</td>
                  <td class="text-center"><i class="fa fa-check-circle fa-2x text-success"></i></td>
                </tr>
                <tr>
                  <td class="text-center">Branches</td>
                  <td class="text-center"><i class="fa fa-check-circle fa-2x text-success"></i></td>
                </tr>
                <tr>
                  <td class="text-center">Accounts</td>
                  <td class="text-center"><i class="fa fa-check-circle fa-2x text-success"></i></td>
                </tr>
                <tr>
                  <td class="text-center">Modules</td>
                  <td class="text-center"><i class="fa fa-check-circle fa-2x text-success"></i></td>
                </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="tab-pane fade" id="branches" role="tabpanel" aria-labelledby="branches-tab">
      <div class="row g-2">
        <div class="col-md-12">
          <p>Manages all branches for the selected member</p>
          <div class="col-12 pb-2">
            <a asp-controller="Member" asp-action="CreateBranch" asp-route-memberid="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
          </div>

              <div class="row pt-2">

                @foreach (var branch in Model.Branches)
                {
                  var allContacts = await WimsApplicationLayer.GetCategorizedContacts(branch.Id, Model.Id).ConfigureAwait(false);
                  var contactsCount = allContacts.SelectMany(c => c.MemberBranchContacts).Count();
                  
                  <div class="col-3 col-lg-3 pb-3 d-flex">
                <div class="card flex-fill">

                  <div class=card-header>
                    <h5 class="card-title"><i class="fa fa-location-dot"></i> @branch.BranchName</h5>
                  </div>
                      <div class="card-body">
                        <div class="card-text"><strong>Province:</strong> @branch.Province</div>
                        <div class="card-text"><strong>Animal Feed Products:</strong> @branch.AnimalFeedProducts.Count</div>
                        <div class="card-text"><strong>Contacts:</strong> @contactsCount</div>
                        <div class="card-text"><strong>Telephone No:</strong> @branch.TelephoneNumber</div>
                      </div>
                  <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Member" asp-action="DetailsBranch" asp-route-id="@branch.Id" class="btn btn-afm-primary w-100"><i class="fa-solid fa-eye"></i> View</a>
                  </div>

                    </div>
                  </div>
                }

              </div>

        </div>
      </div>
    </div>
    <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
    <div class="row g-2">
      <div class="col-md-12">
        <p>Manages all documentation and downloads for the selected member</p>
        <div class="col-12 pb-2">
          <a asp-controller="Member" asp-action="CreateDocument" asp-route-memberId="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="row">

                  <div class="table-responsive">
                    <table class="table table-striped table-sm table-bordered">
                      <thead>
                      <tr>
                        <th scope="col" class="w-10">Name</th>
                        <th scope="col" class="w-10">Document Type</th>
                        <th scope="col" class="w-25">File Name</th>
                        <th scope="col" class="w-15">Expiry Date</th>
                        <th scope="col" class="w-15">Notification</th>
                        <th class="w-15"></th>
                      </tr>
                      </thead>
                      <tbody>
                      @foreach (var document in Model.Documents)
                      {
                        <tr>
                          <td class="align-middle">
                            @document.Name
                          </td>
                          <td class="align-middle">
                            @document.DocumentType
                          </td>
                          <td class="align-middle">
                            @document.DocumentFileName
                          </td>
                          <td class="align-middle">
                            @document.ExpiryDate
                          </td>
                          <td class="align-middle">
                            @document.LastNotificationSent
                          </td>
                          <td class="text-center">
                            <a asp-action="DownloadDocument" asp-controller="Member" asp-route-id="@document.Id" class="btn btn-afm-primary btn-sm" target="_blank"><i class="fa-solid fa-download"></i> Download</a>
                            <a asp-action="EditDocument" asp-controller="Member" asp-route-id="@document.Id" class="btn btn-afm-secondary btn-sm"><i class="fa-solid fa-edit"></i> Edit</a>
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteDocument" onclick="$('#deleteDocumentId').val('@document.Id');"><i class="fa-solid fa-trash"></i> Delete</button>
                          </td>
                        </tr>
                      }
                      </tbody>
                    </table>
                  </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
    <div class="tab-pane fade" id="committees" role="tabpanel" aria-labelledby="committees-tab">
    <div class="row g-2">
      <div class="col-md-12">
        <p>Manages all committee memberships and for the selected member</p>
        <div class="col-12 pb-2">
          <a asp-controller="Member" asp-action="CreateCommittee" asp-route-memberid="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
        </div>

          <div class="row pt-2 h-75">
          @foreach (var committee in Model.Committees)
            {
              <div class="col-3 col-lg-3 pb-3 d-flex">
                <div class="card flex-fill">
                  <div class=card-header>
                    <h5 class="card-title"><i class="fa fa-group"></i> @committee.Committee</h5>
                  </div>
                  <div class="card-body">
                    <div class="card-text"><strong>Member:</strong> @committee.Member</div>
                    <div class="card-text"><strong>Contact:</strong> @committee.Name</div>
                    <div class="card-text"><strong>Email:</strong> @committee.EmailAddress</div>
                    <div class="card-text"><strong>Documents:</strong> @committee.Documents.Count</div>
                  </div>
                  <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Member" asp-action="DetailsCommittee" asp-route-id="@committee.Id" class="btn btn-afm-primary  w-100"><i class="fa-solid fa-eye"></i> View</a>
                  </div>
                </div>
              </div>
            }
        </div>
      </div>
    </div>
  </div>
    <div class="tab-pane fade" id="users" role="tabpanel" aria-labelledby="users-tab">
      <div class="row g-2">
        <div class="col-md-12">
          <p>Manages all users linked to this member that is allowed to update member information</p>
          <div class="col-12 pb-2">
            <a asp-controller="Member" asp-action="CreateUser" asp-route-memberid="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New User</a>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="row">

                @if (!Model.Users.Any())
                {
                 <p>No users found. Create a new user to continue</p> 
                } 
                else
                {
                  <div class="table-responsive">
                    <table class="table table-striped table-sm table-bordered">
                      <thead>
                        <tr>
                          <th scope="col" class="w-15">First Name</th>
                          <th scope="col" class="w-15">Last Name</th>
                          <th scope="col" class="w-25">Email</th>
                          <th scope="col" class="w-10">Branches</th>
                          <th scope="col" class="w-10">Edit</th>
                          <th scope="col" class="w-10">Status</th>
                          <th class="w-5"></th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var item in Model.Users)
                        {
                          <tr>
                            <td class="align-middle">
                              @item.FirstName
                            </td>
                            <td class="align-middle">
                              @item.LastName
                            </td>
                            <td class="align-middle">
                              @item.Email
                            </td>
                            <td class="align-middle">
                              @item.Branches?.Count
                            </td>
                            <td class="align-middle">
                              @item.CanEdit.BooleanToYesNo()
                            </td>
                            <td class="align-middle text-center">
                              @item.IsActive.BooleanToActiveInactive()
                            </td>
                            <td class="text-center">
                              <a asp-action="DetailsUser" asp-controller="Member" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
                            </td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div> 
</div>

<partial name="Delete" model='new DeleteViewModel { Id = Model.Id }' />
<partial name="DeleteDocument" model='new DeleteViewModel { ParentId = Model.Id }' />

<script>
  $('#deleteDocument').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget);
      var documentId = button.data('id');

      $('#deleteDocumentId').val(documentId);
  });
</script>