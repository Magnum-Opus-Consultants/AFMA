@model AFMA.ApplicationLayer.Model.Wims.NotificationTemplateModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Notification Template</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">View Notification Template</h3>
  <p>Manages all notification templates and related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <div class="row mt-2">
            <div class="col-8">
              <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" disabled />
              </div>
            </div>

            <div class="col-4">
              <div class="form-group">
                <label asp-for="NotificationType" class="form-label"></label>
                <input asp-for="NotificationType" class="form-control" disabled />
              </div>
            </div>

          </div>

          <div class="row mt-2">
            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" disabled />
              </div>
            </div>
          </div>

          <div class="row mt-2">
            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="Body" class="form-label"></label>
                <textarea asp-for="Body" class="form-control" disabled rows="10"></textarea>
              </div>
            </div>
          </div>

          <div style="float: left" class="mt-4">
            <a asp-controller="NotificationTemplate" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
          </div>

          <div style="float: right" class="mt-4">
            <a asp-controller="NotificationTemplate" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteNotificationTemplate"><i class="fa-solid fa-trash"></i> Delete</button>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<hr />

<div class="col-md-12">
  <h3 class="fw-black">Contacts</h3>
  <div class="card">
    <div class="card-body">

      <div class="row g-2">
        <div class="col-12 pb-2">
          <a asp-controller="NotificationTemplate" asp-action="CreateContact" asp-route-notificationTemplateId="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-sm table-bordered">
            <thead>
              <tr>
                <th scope="col" class="w-15">Contact Name</th>
                <th scope="col">Email Address</th>
                <th class="w-15"></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model.NotificationContacts)
              {
                <tr>
                  <td class="align-middle">
                    @item.FullName
                  </td>
                  <td class="align-middle">
                    @item.EmailAddress
                  </td>
                  <td class="text-center">
                    <a asp-action="EditContact" asp-controller="NotificationTemplate" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> Edit</a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteNotificationContact" onclick="$('#deleteContactId').val('@item.Id');"><i class="fa-solid fa-trash"></i> Delete</button>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<partial name="Delete" model='new DeleteViewModel { Id = Model.Id }' />
<partial name="DeleteContact" model='new DeleteViewModel { Id = Model.Id, ParentId = Model.Id }' />