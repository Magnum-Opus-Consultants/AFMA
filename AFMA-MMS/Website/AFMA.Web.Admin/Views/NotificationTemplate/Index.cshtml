@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.NotificationTemplateModel>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Notification Templates</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Notification Templates</h3>
  <p>Manages all notification templates and related information</p>
  <div class="card">
    <div class="card-body">
      <div class="col-12 pb-3">
        <a asp-controller="NotificationTemplate" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-sm table-bordered">
          <thead>
            <tr>
              <th scope="col" class="w-25">Description</th>
              <th scope="col" class="w-25">Notification Type</th>
              <th scope="col" class="w-5">Contacts</th>
              <th class="w-5"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model)
            {
              <tr>
                <td class="align-middle">
                  @item.Description
                </td>
                <td class="align-middle">
                  @item.NotificationType
                </td>
                <td class="align-middle">
                  @item.NotificationContacts.Count
                </td>
                <td class="text-center">
                  <a asp-action="Details" asp-controller="NotificationTemplate" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>