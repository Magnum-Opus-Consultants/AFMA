@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AFMA.ApplicationLayer.Model.Wims.DistributionGroupModel>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Distribution</a></li>
    <li class="breadcrumb-item active" aria-current="page">Groups</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Distribution Groups</h3>
  <p>Manages all distribution groups and related information</p>
  <div class="card">
    <div class="card-body">
      <div class="col-12 pb-3">
        <a asp-controller="Distribution" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New</a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-sm table-bordered">
          <thead>
            <tr>
              <th scope="col" class="w-15">Name</th>
              <th scope="col" class="w-25">Description</th>
              <th scope="col" class="w-25">From Address</th>
              <th scope="col" class="w-15">Visibility</th>
              <th scope="col" class="w-5">Members</th>
              <th class="w-5"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model)
            {
              <tr>
                <td class="align-middle">
                  @item.Name
                </td>
                <td class="align-middle">
                  @item.Description
                </td>
                <td class="align-middle">
                  @item.FromAddress
                </td>
                <td class="align-middle">
                  @(item.Private ? "Private" : "Public")
                </td>
                <td class="align-middle text-center">
                  @item.DistributionGroupMembers.Count
                </td>
                <td class="text-center">
                  <a asp-action="Details" asp-controller="Distribution" asp-route-id="@item.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>