@model AFMA.ApplicationLayer.Model.Wims.DistributionGroupModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Distribution</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Distribution Group</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Edit Distribution Group</h3>
  <p>Manages all distribution group related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="Edit" method="post">

            <div class="row mt-2">
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="Name" class="form-label"></label>
                  <input asp-for="Name" class="form-control" />
                  <span asp-validation-for="Name"></span>
                </div>
              </div>

              <div class="col-6">
                <div class="form-group">
                  <label asp-for="Description" class="form-label"></label>
                  <input asp-for="Description" class="form-control" />
                  <span asp-validation-for="Description"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="Owner" class="form-label"></label>
                  <input asp-for="Owner" class="form-control" />
                  <span asp-validation-for="Owner"></span>
                </div>
              </div>
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="FromAddress" class="form-label"></label>
                  <input asp-for="FromAddress" class="form-control" />
                  <span asp-validation-for="FromAddress"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-6 mt-2">
                <div class="form-group">
                  <input asp-for="Private" class="form-check-input" type="checkbox">
                  <label asp-for="Private" class="form-check-label">Private</label>
                </div>
              </div>
            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="Distribution" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}