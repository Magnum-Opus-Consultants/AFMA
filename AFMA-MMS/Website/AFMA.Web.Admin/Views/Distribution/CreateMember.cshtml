@model AFMA.ApplicationLayer.Model.Wims.DistributionGroupMemberModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Distribution</a></li>
    <li class="breadcrumb-item active" aria-current="page">Create Group Member</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Create Group Member</h3>
  <p>Manages all distribution group related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="CreateMember" method="post">
            
            <input type="hidden" asp-for="DistributionGroupId" />

            <div class="row mt-2">
              <div class="col-12">
                <div class="alert alert-success d-flex" role="alert">
                  <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                  <div class="ms-3">
                    <h6 class="text-reset">Note!</h6>
                    Select an existing member and contact to quickly populate the group member details. If you want add a non-member, simply ignore these fields and enter the Name and Email below.
                    <br />
                    <div class="row mt-3">
                      <div class="col-4">
                        <div class="form-group">
                          <label class="form-label">Member</label>
                          <select id="filterMemberId" name="filterMemberId" class="form-control" asp-items="@(await WimsApplicationLayer.GenerateMemberSelectList(null))">
                            <option value="">-- Select Member, or leave blank for non-member contact --</option>
                          </select>
                        </div>
                      </div>

                      <div class="col-4">
                        <div class="form-group">
                          <label class="form-label">Branch</label>
                          <select id="filterMemberBranchId" name="filterMemberBranchId" class="form-control" asp-items="@(await WimsApplicationLayer.GenerateMemberBranchSelectList(null, null))"></select>
                        </div>
                      </div>

                      <div class="col-4">
                        <div class="form-group">
                          <label class="form-label">Contact</label>
                          <select id="memberBranchContactId" name="memberBranchContactId" class="form-control"></select>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>           


            <div class="row mt-2">
              <div class="col-12 mt-2">
                <div class="form-group">
                  <label asp-for="ContactName" class="form-label"></label>
                  <input asp-for="ContactName" class="form-control"/>
                  <span asp-validation-for="ContactName"></span>
                </div>
              </div>
            </div>

            <div class="row mt-2">
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="EmailAddress" class="form-label"></label>
                  <input asp-for="EmailAddress" class="form-control"/>
                  <span asp-validation-for="EmailAddress"></span>
                </div>
              </div>
              <div class="col-6 mt-2">
                <div class="form-group">
                  <label asp-for="ContactNumber" class="form-label"></label>
                  <input asp-for="ContactNumber" class="form-control"/>
                  <span asp-validation-for="ContactNumber"></span>
                </div>
              </div>

            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="Distribution" asp-action="Details" asp-route-id="@Model.DistributionGroupId" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}

<script>

  $(function () {

    $("select#filterMemberId").change(function () {
      var mid = $(this).val();
      $("select#filterMemberBranchId").empty();
      $("select#memberBranchContactId").empty();

      $.getJSON(`/Member/GetMemberBranches?memberId=${mid}`,
        function (data) {
          $("select#filterMemberBranchId").append(`<option value="">-- Select Branch --</option>`);
          $.each(data,
            function (i, item) {
              $("select#filterMemberBranchId").append(`<option value="${item.id}">${item.branchName}</option>`);
            });
        });
    });

    $("select#filterMemberBranchId").change(function () {
      var bid = $(this).val();

      $("select#memberBranchContactId").empty();

      $.getJSON(`/Member/GetMemberBranchContacts?memberBranchId=${bid}`,
        function (data) {
          $("select#memberBranchContactId").append(`<option value="">-- Select Branch Contact --</option>`);
          $.each(data,
            function (i, item) {
              $("select#memberBranchContactId").append(`<option value="${item.id}">${item.emailAddress}</option>`);
            });
        });
    });

    $("select#memberBranchContactId").change(function () {
      var aid = $(this).val();

      $.getJSON(`/Member/GetMemberBranchContact?memberBranchContactId=${aid}`,
        function (data) {
          $("#ContactName").val(data.firstName + " " + data.surname);
          $("#EmailAddress").val(data.emailAddress);
          $("#ContactNumber").val(data.contactNumber);
        });
    });

  });

</script>