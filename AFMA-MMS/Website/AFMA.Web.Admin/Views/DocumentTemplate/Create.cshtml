@model AFMA.ApplicationLayer.Model.Wims.DocumentTemplateModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Create Document Template</li>
  </ol>
</nav>

<div class="col-md-12">
  <h3 class="fw-black">Create Document Template</h3>
  <p>Manages document templates related information</p>
  <div class="row g-2">
    <div class="col-12">
      <div class="card">
        <div class="card-body">

          <form class="needs-validation" novalidate asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="row mt-2">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="Name" class="form-label"></label>
                  <input asp-for="Name" class="form-control" />
                  <span asp-validation-for="Name"></span>
                </div>
              </div>
            </div>
            
            <div class="row mt-2">
              <div class="col-12">
                <div class="form-group">
                  <label asp-for="TemplateContent" class="form-label"></label>
                  <input asp-for="TemplateContent" class="form-control" type="file">
                  <span asp-validation-for="TemplateContent"></span>
                </div>
              </div>
            </div>

            <div style="float: right" class="mt-4">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="DocumentTemplate" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="~/js/max-file-size-validation.js"></script>

@section Scripts
{
  @await Html.PartialAsync("_ValidationScriptsPartial")
}