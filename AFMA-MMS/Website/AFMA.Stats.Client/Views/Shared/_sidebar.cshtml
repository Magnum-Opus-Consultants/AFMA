    <div data-simplebar class="h-100">
      <div id="sidebar-menu">
        <ul class="metismenu list-unstyled" id="side-menu">

          <li class="menu-title" key="t-menu">Menu</li>

          <li>
            <a href=@Url.Action("Index", "Home") class="waves-effect">
              <i class="bx bxs-dashboard"></i>
              <span key="t-dashboard">Dashboard</span>
            </a>
          </li>

          @if (memberAccess.HasFeedsalesAccess)
          {
            <li class="menu-title mt-3" key="t-feedsales">Feesales</li>

            <li>
              <a href=@Url.Action("Guideline", "Feedsales") class="waves-effect">
                <i class="bx bxs-help-circle"></i>
                <span key="t-guideline-fs">Guideline</span>
              </a>
            </li>

            <li>
              <a href=@Url.Action("Index", "Feedsales") class="waves-effect">
                <i class="bx bx-clipboard"></i>
                <span key="t-submit-reports-fs">Submit Reports</span>
              </a>
            </li>

            <li>
              <a href="javascript: void(0);" class="has-arrow waves-effect">
                <i class="bx bxs-report"></i>
                <span key="t-reports-fs">Reports</span>
              </a>
              <ul class="sub-menu" aria-expanded="false">
                <li><a href=@Url.Action("Report", "Feedsales")><span key="t-report-total-fs">Feedsales Total</span></a></li>
              </ul>
            </li>
          }

          @if (memberAccess.HasIndustryProfileAccess)
          {
            <li class="menu-title mt-3" key="t-adminkit">Industry Profile</li>

            <li>
              <a href=@Url.Action("Guideline", "IndustryProfile") class="waves-effect">
                <i class="bx bxs-help-circle"></i>
                <span key="t-guideline-ip">Guideline</span>
              </a>
            </li>

            <li>
              <a href=@Url.Action("Index", "IndustryProfile") class="waves-effect">
                <i class="bx bx-clipboard"></i>
                <span key="t-submmit-reports-ip">Submit Reports</span>
