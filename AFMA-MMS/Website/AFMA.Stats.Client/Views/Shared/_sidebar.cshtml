                <span key="t-guideline-mt">Guideline</span>
              </a>
            </li>

            <li>
              <a href=@Url.Action("Index", "Mycotoxin") class="waves-effect">
                <i class="bx bx-clipboard"></i>
                <span key="t-submit-reports-mt">Submit Reports</span>
              </a>
            </li>

            <li>
              <a href="javascript: void(0);" class="has-arrow waves-effect">
                <i class="bx bxs-report"></i>
                <span key="t-reports-mt">Reports</span>
              </a>
              <ul class="sub-menu" aria-expanded="false">
                <li><a href=@Url.Action("ComingSoon", "Home")><span key="t-calendar4">Under development</span></a></li>
              </ul>
            </li>
          }
        </ul>
      </div>
    </div>
  </div>
