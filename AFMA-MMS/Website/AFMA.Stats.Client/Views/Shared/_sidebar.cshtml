              <ul class="sub-menu" aria-expanded="false">
                <li><a href=@Url.Action("SummaryReport", "IndustryProfile")><span key="t-calendar2">Industry Profile Summary</span></a></li>
              </ul>
            </li>
          }

          @if (memberAccess.HasSalmonellaAccess)
          {
            <li class="menu-title mt-3" key="t-salmonella">Salmonella</li>

            <li>
              <a href=@Url.Action("Guideline", "Salmonella") class="waves-effect">
                <i class="bx bxs-help-circle"></i>
                <span key="t-guideline-s">Guideline</span>
              </a>
            </li>

            <li>
              <a href=@Url.Action("Index", "Salmonella") class="waves-effect">
                <i class="bx bx-clipboard"></i>
                <span key="t-submit-reports-s">Submit Reports</span>
              </a>
            </li>

            <li>
              <a href="javascript: void(0);" class="has-arrow waves-effect">
                <i class="bx bxs-report"></i>
                <span key="t-reports-s">Reports</span>
              </a>
              <ul class="sub-menu" aria-expanded="false">
                <li><a href=@Url.Action("Report", "Salmonella")><span key="t-calendar3">Salmonella Details</span></a></li>
              </ul>
            </li>
          }

          @if (memberAccess.HasMycotoxinAccess)
          {
            <li class="menu-title mt-3" key="t-mycotoxib">Mycotoxins</li>

            <li>
              <a href=@Url.Action("Guideline", "Mycotoxin") class="waves-effect">
