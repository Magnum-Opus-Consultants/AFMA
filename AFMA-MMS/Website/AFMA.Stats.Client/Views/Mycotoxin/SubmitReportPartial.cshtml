@model int

<div class="modal fade" id="submitMycotoxinReport" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="submitMycotoxinReportLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="submitMycotoxinReportLabel">Submit Mycotoxin Report</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form class="needs-validation" novalidate asp-route-mycotoxinReportId="@Model" asp-action="Submit" method="post">
        <div class="modal-body">
          <div class="row">
            <div class="col-12">
              <p>Are you sure you want to submit this Mycotoxin Report?</p>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
          <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> Submit</button>
        </div>
      </form>
    </div>
  </div>
</div>