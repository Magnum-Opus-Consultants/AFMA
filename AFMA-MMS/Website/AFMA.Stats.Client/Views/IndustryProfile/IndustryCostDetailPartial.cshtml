@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.IndustryCostGroupModel>

@{
  decimal _pTotal = 0;
  decimal _gTotal = 0;
  var id = Convert.ToInt32(ViewData["IndustryProfileReportId"]);
  Enum.TryParse(ViewData["CurrentPageAction"]?.ToString(), out CurrentPageAction currentPageAction);
}

<div class="row">
  <div class="col-12">

    @foreach (var group in Model)
    {
      <h4 class="card-title pt-3">@group.GroupName</h4>
      <table class="table table-responsive table-sm table-bordered">
        @foreach (var item in group.Items)
        {
          _gTotal = await ApplicationLayer.GetCostFromTable(item.LinkedId1, item.LinkedId2, id, item.LinkedTable, item.Id, item.RunningCostType, null, item.IndustryCostGroupId);
          _pTotal = _pTotal + _gTotal;
          <tr>
            <td>@item.ItemName</td>
            <td class="td-w-20">@($"{_gTotal:c}")</td>
            <td class="td-w-20" style="width:20%"></td>
          </tr>
        }
        <tr>
          <th class="td-afm-secondary">TOTAL</th>
          <th class="td-afm-secondary">@($"{_pTotal:c}")</th>
          <th class="td-afm-secondary"></th>
        </tr>

      </table>

      _pTotal = 0;
      _gTotal = 0;
    }
  </div>

</div>