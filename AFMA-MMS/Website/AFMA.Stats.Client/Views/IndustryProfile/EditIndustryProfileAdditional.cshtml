@model AFMA.ApplicationLayer.ViewModels.CompanyIndustryProfileViewModel

@{
  ViewBag.PageTitle = "Industry Profile";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Industry Profile";
  ViewBag.Action = "Edit Report";
  var groups = await ApplicationLayer.GetIpAdditionalGroups(false).ConfigureAwait(false);
}

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Edit Additional Information</h4>
        <p class="card-title-desc">Edit your industry profile report data.</p>

        <form class="needs-validation" novalidate asp-action="EditIndustryProfileAdditional" method="post">
          <input asp-for="IndustryProfileReportId" type="hidden" />
          <input asp-for="MemberId" type="hidden" />
          <input asp-for="MemberBranchId" type="hidden" />
          <input asp-for="MemberTypeId" type="hidden" />

          <div class="row">
            <div class="col-md-12">

              @foreach (var group in groups)
              {
                <table class="table table-responsive table-striped table-condensed table-bordered">
                  <tr>
                    <th class="td-afm-secondary td-w-5"></th>
                    <th class="td-afm-secondary"></th>
                    <th class="td-afm-secondary td-w-20 text-center"><strong>(@group.GroupMeasure)</strong></th>
                  </tr>
                  <tr>
                    <th class="td-afm-secondary"><strong>@group.GroupCode</strong></th>
                    <th class="td-afm-secondary"><strong>@group.GroupName</strong></th>
                    <th class="td-afm-secondary"><strong></strong></th>
                  </tr>

                  @foreach (var item in Model.MemberIpAdditionalItems.Where(x => x.IpAdditionalGroupId == group.Id))
                  {
                    <tr>
                      <td class="align-middle"></td>
                      <td class="align-middle">@item.ItemDescription</td>
                      <td>
                        <input type="number" id="IPAdditionalItem_@item.Id" name="IPAdditionalItem_@item.Id" class="form-control" value="@item.Value" />
                      </td>
                    </tr>
                  }
                </table>
              }
            </div>
          </div>

          <hr />
          <div style="float: right">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
            <a asp-action="Details" asp-controller="IndustryProfile" asp-route-id="@Model.IndustryProfileReportId" class="btn btn-secondary"><i class="fa fa-times"></i> Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

