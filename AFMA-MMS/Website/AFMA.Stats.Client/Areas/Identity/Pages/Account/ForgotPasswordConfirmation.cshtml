@page
@using AFMA.Stats.Client.Areas.Identity.Pages.Account
@model ForgotPasswordConfirmation
@{
  ViewData["Title"] = "Forgot Password";
  Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<style scoped>

  .font-size-28 {
    font-size: 28px !important;
  }

  .font-size-30 {
    font-size: 40px !important;
  }

</style>

<div class="account-pages my-5 pt-sm-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card overflow-hidden">
          <div class="row g-0">

            <div class="col-6 p-5 p-4 align-middle">
              <div class="font-size-28 text-gray-700 fw-bold fs-6 d-grid"><strong>AFMA Statistics Portal</strong></div>
              <div class="font-size-15 text-gray-700 fw-bold fs-6 d-grid">Animal Feed Sales and related information</div>
            </div>
            <div class="col-6 p-5" style="text-align:right">
              <a href=@Url.Action("Index", "Home") class="1auth-logo">
                <img src="~/assets/images/afma-logo-1.png" alt="" height="90">
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-10 col-lg-10 col-xl-10">
        <div class="card">
          <div class="card-body">
            <div class="p-2">
              <div class="text-center">

                <div class="avatar-md mx-auto">
                  <div class="avatar-title rounded-circle bg-light">
                    <i class="bx bxs-envelope h1 mb-0 text-primary"></i>
                  </div>
                </div>
                <div class="p-2 mt-4">
                  <h4>Verification email sent!</h4>
                  <p class="text-muted">If your email address is registered with AFMA, you will receive an email with instructions to reset your password shortly.</p>
                  <div class="mt-4">
                    <a href=@Url.Action("Index", "Home") class="btn btn-primary w-md">Sign In</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-5 text-center">
          <p>Did't receive an email ? <a href="/Identity/Account/ForgotPassword" class="fw-semibold text-primary text-decoration-underline"> Resend </a> </p>
          <p>
            Copyright © <script>document.write(new Date().getFullYear())</script> <b>Animal Feed Manufacturers Association (AFMA)</b>.<br />
            Registration Number: 1988/005169/08<br />
            Association incorporated under section 21 I 024-025-NPO
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
