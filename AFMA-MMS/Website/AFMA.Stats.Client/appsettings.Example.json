{
  "ConnectionStrings": {
    "ApplicationRepository": "Server=;Database=afmastats;Integrated Security=false;User ID=;Password=;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationSettings": {
    "Deployment": "Not Deployed",
    "BaseUrl": "https://localhost:44365",
    "PageSize": "25",
    "Debug": "true",
    "Version": "1.0.XXX",
    "TestSite": true
  },
  "SMTPSettings": {
    "Host": "smtp.mailgun.org",
    "Port": "587",
    "Username": "<USERNAME>",
    "Password": "<SECRET>",
    "FromName": "AFMA",
    "FromAddress": "noreply@afma.co.za",
    "Auth": "true",
    "Debug": "false",
    "DebugEmail": "stats@afma.co.za",
    "SubmissionStatsEmail": "stats@afma.co.za"
  },
  "EPPlus": {
    "ExcelPackage": {
      "LicenseContext": "NonCommercial"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": {
      "MSSqlServer": {
        "Name": "MSSqlServer",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "connectionString": "ApplicationRepository",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "Source",
                "PropertyName": "SourceContext",
                "DataType": "varchar",
                "DataLength": 200
              }
            ],
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "logEvent": {
              "excludeAdditionalProperties": true,
              "excludeStandardColumns": true
            }
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
