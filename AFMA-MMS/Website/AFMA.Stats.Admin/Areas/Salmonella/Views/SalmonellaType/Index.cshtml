@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AFMA.ApplicationLayer.Model.SalmonellaTypeModel>

@{
  var filterSalmonellaGroupId = Context.Request.Query["filterSalmonellaGroupId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Salmonella</a></li>
    <li class="breadcrumb-item active" aria-current="page">Salmonella Types</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Salmonella Types</h4>
    </div>
    
    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">
          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Salmonella Group</label>
              <select id="filterSalmonellaGroupId" name="filterSalmonellaGroupId" class="form-control" asp-items="@await SalmonellaLayer.GenerateSalmonellaGroupSelectList(filterSalmonellaGroupId)">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-4">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search salmonella type names..." value="@filterSearchText"/>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br/>
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="col-12 pb-3">
      <a asp-area="Salmonella" asp-controller="SalmonellaType" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Salmonella Type</a>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col" class="w-15">Group</th>
          <th scope="col" class="text-center w-5">Active</th>
          <th scope="col" class="w-5"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var salmonellaType in Model)
        {
          <tr>
            <td class="align-middle">@salmonellaType.Name</td>
            <td class="align-middle">@salmonellaType.SalmonellaGroup</td>
            <td class="align-middle">@Html.Raw(salmonellaType.Active.ToFormattedActiveInactive())</td>
            <td class="text-center">
              <a asp-area="Salmonella" asp-controller="SalmonellaType" asp-action="Details" asp-route-id="@salmonellaType.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterSalmonellaGroupId, filterSearchText }))
    </div>
  </div>
</div>