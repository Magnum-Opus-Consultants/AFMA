@using X.PagedList.Mvc.Core
@using X.PagedList
@model IEnumerable<AFMA.ApplicationLayer.Model.SalmonellaSampleTypeItemModel>

@{
  var filterSalmonellaSampleTypeId = Context.Request.Query["filterSalmonellaSampleTypeId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Salmonella</a></li>
    <li class="breadcrumb-item active" aria-current="page">Main Locations</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Main Locations</h4>
    </div>
    
    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">
          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Sample Type</label>
              <select id="filterSalmonellaSampleTypeId" name="filterSalmonellaSampleTypeId" class="form-control" asp-items="@await ApplicationLayer.GenerateSalmonellaSampleTypeSelectList(filterSalmonellaSampleTypeId)">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-4">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search location names..." value="@filterSearchText" />
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br />
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="col-12 pb-3">
      <a asp-area="Salmonella" asp-controller="MainLocation" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Main Location</a>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col" class="w-25">Sample Type</th>
          <th scope="col">Name</th>
          <th scope="col" class="text-center w-5">Active</th>
          <th scope="col" class="w-5"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var location in Model)
        {
          <tr>
            <td class="align-middle">@location.SalmonellaSampleType</td>
            <td class="align-middle">@location.Name</td>
            <td class="align-middle text-center">@Html.Raw(location.Active.ToFormattedActiveInactive())</td>
            <td class="text-center">
              <a asp-area="Salmonella" asp-controller="MainLocation" asp-action="Details" asp-route-id="@location.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterSalmonellaSampleTypeId, filterSearchText }))
    </div>
  </div>
</div>