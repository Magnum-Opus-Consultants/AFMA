@model AFMA.ApplicationLayer.Model.SalmonellaSampleTypeSubItemModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Salmonella</a></li>
    <li class="breadcrumb-item"><a href="#">Sub Locations</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Sub Location</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Edit Sub Location</h4>
    </div>
    
    <form class="needs-validation" novalidate asp-action="Edit" method="post">
      <div class="row g-2">
        <div class="col-12">
          
          <div class="form-group mt-2">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required/>
            <div class="invalid-feedback">Name is required.</div>
          </div>
          
          <div class="form-group mt-2">
            <label asp-for="ShortCode" class="form-label"></label>
            <input asp-for="ShortCode" class="form-control" required/>
            <div class="invalid-feedback">Name is required.</div>
          </div>

          <div class="form-group mt-2">
            <label asp-for="SalmonellaSampleTypeId" class="form-label"></label>
            <select class="form-control" asp-for="SalmonellaSampleTypeId" asp-items="@(await ApplicationLayer.GenerateSalmonellaSampleTypeSelectList(Model.SalmonellaSampleTypeId))" required>
              <option value="">-- Select Sample Type --</option>
            </select>
            <div class="invalid-feedback">Sample Type is required.</div>
          </div>
          
          <div class="form-check mt-2">
            <input asp-for="VisibleToMembers" class="form-check-input" type="checkbox" checked>
            <label asp-for="VisibleToMembers" class="form-check-label">Visible To Members</label>
          </div>

          <div class="form-check mt-2">
            <input asp-for="Active" class="form-check-input" type="checkbox" checked>
            <label asp-for="Active" class="form-check-label">Active</label>
          </div>

        </div>
      </div>
      
      <div class="mt-2 float-md-end">
        <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
        <a asp-area="Salmonella" asp-controller="SubLocation" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a> 
      </div>
    </form>
  </div>
</div>