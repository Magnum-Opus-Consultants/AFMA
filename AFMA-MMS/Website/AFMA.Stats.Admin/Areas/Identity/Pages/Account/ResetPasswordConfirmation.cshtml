@page
@using AFMA.Stats.Admin.Areas.Identity.Pages.Account
@model ResetPasswordConfirmationModel

@{
  ViewData["Title"] = "Password Reset Successful";
}


<div class="row">
  <div class="col-6 p-3">
    <h1 class="fw-black mb-2">AFMA Statistics Portal</h1>
    <p class="fw-light text-secondary mb-4">Animal Feedsales and related information</p>
  </div>
  <div class="col-6 p-3">
    <img alt="AFMA Statistics" src="~/img/afma-logo-1.png" width="auto" height="64" class="pull-right">
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="mb-3">
      <h4>Reset Password Successful</h4>
    </div>
    <div class="mb-3">
      <p class="fw-light text-secondary mb-4">Your password has ben changed successfully. Please log in by clicking the Sign In button below.</p>
    </div>
    <a asp-area="Identity" asp-page="Login" class="btn btn-afm-primary w-100">Sign In</a>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial"/>
}