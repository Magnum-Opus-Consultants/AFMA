@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AFMA.ApplicationLayer.Model.MycotoxinTypeModel>

@{
  var filterMycotoxinClassId = Context.Request.Query["filterMycotoxinClassId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
}


<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Mycotoxin Types</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Mycotoxin Types</h4>
    </div>
    
    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">
          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Mycotoxin Class</label>
              <select id="filterMycotoxinClassId" name="filterMycotoxinClassId" class="form-control" asp-items="@await MycotoxinLayer.GenerateMycotoxinClassSelectList(filterMycotoxinClassId)">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-4">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search type names..." value="@filterSearchText" />
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br />
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="col-12 pb-3">
      <a asp-area="Mycotoxin" asp-controller="Type" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Mycotoxin Type</a>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col" class="w-25">Class</th>
          <th scope="col" class="w-5 text-center">Visible</th>
          <th class="w-10"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var mycotoxin in Model)
        {
          <tr>
            <td class="align-middle">
              @mycotoxin.Name
            </td>
            <td class="align-middle">
              @mycotoxin.MycotoxinClass
            </td>
            <td class="align-middle text-center">
              @Html.Raw(mycotoxin.Active.ToFormattedActiveInactive())
            </td>
            <td class="text-center">
              <a asp-area="Mycotoxin" asp-action="Details" asp-controller="Type" asp-route-id="@mycotoxin.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterMycotoxinClassId, filterSearchText }))
    </div>
  </div>
</div>