@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AFMA.ApplicationLayer.Model.UserModel>

@{
  var filterSearchText = Context.Request.Query["filterSearchText"];
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Users</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Users</h4>
    </div>
    
    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">
          <div class="col-4">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search user first and last names, usernames and email addresses..." value="@filterSearchText" />
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br />
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col">Member</th>
          <th scope="col">Username</th>
          <th scope="col">Full Name</th>
          <th scope="col">Email Address</th>
          <th scope="col">Receive Email</th>
          <th scope="col">Last Login</th>
          <th scope="col">Roles</th>
          <th scope="col" class="w-10"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
          <tr>
            <td class="align-middle">@user.MemberName</td>
            <td class="align-middle">@user.Username</td>
            <td class="align-middle">@user.FullName</td>
            <td class="align-middle">@user.Email</td>
            <td class="align-middle">@Html.Raw(user.ReceiveEmail.GetValueOrDefault().ToCustomFormattedTrueFalse("success", "YES", "danger", "NO"))</td>
            <td class="align-middle">@user.LastLogin</td>
            <td class="align-middle text-center">@Html.Raw(user.RoleNameFormatted)</td>
            <td class="align-middle text-center">
              <a asp-area="" asp-action="AccountDetails" asp asp-controller="Member" asp-route-userid="@user.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View Account</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterSearchText }))
    </div>
  </div>
</div>