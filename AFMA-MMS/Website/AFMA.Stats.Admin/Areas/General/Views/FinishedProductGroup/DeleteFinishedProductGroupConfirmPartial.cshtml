@model AFMA.ApplicationLayer.Model.NotificationModel

<div class="modal fade" id="deleteFinishedProductGroupConfirm" tabindex="-1" aria-labelledby="deleteFinishedProductGroupConfirmLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Delete Finished Product Group</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-productGroupId="@Model.Id" asp-controller="FinishedProductGroup" asp-action="Delete" method="post">
          <div class="row">
            <div class="col-12">
              <p>Confirm that this finished product group is to be deleted.</p>
              <p class="text-danger">NOTE!! This product group cannot be deleted it is linked to an active finished product.</p>
            </div>
          </div>
          <div class="row mt-2 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>