@model IEnumerable<AFMA.ApplicationLayer.Model.MemberTypeModel>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">System Admin</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Member Types</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Member Types</h4>
    </div>

    <div class="col-12 pb-3">
      <a asp-area="General" asp-controller="MemberType" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Member Type</a>
    </div>

    <div class="col-12">
      <div class="alert alert-warning"><i class="fa-solid fa-circle-exclamation"></i> Do not edit anything here unless you know what you are doing?!?!?!</div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col" class="w-5"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td class="align-middle">
                @item.Description
              </td>
              <td class="text-center">
                <a asp-area="General" asp-controller="MemberType" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>