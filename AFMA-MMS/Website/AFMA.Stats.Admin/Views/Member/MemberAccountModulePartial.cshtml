@model IEnumerable<AFMA.ApplicationLayer.Model.MemberAccountModuleModel>

@{
  var modules = ApplicationLayer.GetModules().Result;
}

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Modules</h4>
    </div>

      
      @foreach (var module in modules)
      {
        <div class="col-12 mt-2">
          <div class="form-check">
            <input id="" class="form-check-input" type="checkbox">
            <label class="form-check-label">Access @module.Description</label>
          </div>
          </div>
      }


