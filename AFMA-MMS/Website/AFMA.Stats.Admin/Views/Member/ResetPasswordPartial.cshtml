@model AFMA.ApplicationLayer.Model.NotificationModel

<div class="modal fade" id="resetAccountPassword" tabindex="-1" aria-labelledby="resetAccountPasswordLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Reset Account Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-userId="@Model.UserId" asp-route-memberAccountId="@Model.MemberAccountId" asp-controller="Member" asp-action="ResetAccountPassword" method="post">
          <div class="row">
            <div class="col-12">
              <p>This action will reset the account's password and send it to the verified email address of the account.</p>
            </div>
          </div>
          <div class="row mt-2 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Continue</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>