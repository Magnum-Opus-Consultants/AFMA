@model AFMA.ApplicationLayer.Model.ReportCriteriaModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Salmonella</a></li>
    <li class="breadcrumb-item"><a href="#">Reports</a></li>
    <li class="breadcrumb-item active" aria-current="page">Detail Salmonella Report</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Detail Salmonella Report</h4>
    </div>
    
    <form class="needs-validation" novalidate asp-action="DetailSalmonellaAdminReport" method="post">
      <div class="row g-2">
        <div class="col-2">
          <div class="form-group">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date"/>
          </div>
        </div>
        
        <div class="col-2">
          <div class="form-group">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date"/>
          </div>
        </div>
        
        <div class="col-2">
          <div class="form-group">
            <label class="form-label">Sample Type</label>
            <select asp-for="SampleTypeId" class="form-control" asp-items="@(await ApplicationLayer.GenerateSalmonellaSampleTypeSelectList(null))">
              <option value="">-- ALL --</option>
            </select>
          </div>
        </div>
        
        <div id="rawMaterial" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="MaterialId" class="form-label"></label>
              <select class="form-control" asp-for="MaterialId" asp-items="@(await SalmonellaLayer.GenerateMaterialSelectList(null))">
                <option value="">-- Select Raw Material --</option>
              </select>
            </div>
          </div>
        </div>

        <div id="finishedProduct" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="ProductId" class="form-label"></label>
              <select class="form-control" asp-for="ProductId" asp-items="@(await SalmonellaLayer.GenerateProductGroupSelectList(null))">
                <option value="">-- Select Finished Product --</option>
              </select>
            </div>
          </div>
        </div>

      </div>
      
      <div style="float: right">
        <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-file-excel"></i> Export</button>
        <a asp-controller="Member" asp-action="Index" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
      </div>

    </form>
  </div>
</div>

<script type="text/javascript">

  $("#SampleTypeId").on('change', function (e) {
      var optionSelected = $("option:selected", this);
      var valueSelected = this.value;

      switch (valueSelected) {
          case "1":
              $("#MaterialId").attr("required");
              $("#ProductId").removeAttr("required");

              $("#rawMaterial").show();
              $("#finishedProduct").hide();
              break;

          case "2":
              $("#ProductId").attr("required");
              $("#MaterialId").removeAttr("required");

              $("#rawMaterial").hide();
              $("#finishedProduct").show();
              break;

          default:
              $("#rawMaterial").hide();
              $("#finishedProduct").hide();
      }
  });

</script>