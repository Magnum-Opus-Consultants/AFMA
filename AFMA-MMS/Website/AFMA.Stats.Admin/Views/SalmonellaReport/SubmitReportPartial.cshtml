@model int

<div class="modal fade" id="submitSalmonellaReport" tabindex="-1" aria-labelledby="submitSalmonellaReportLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Submit Salmonella Report</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-salmonellaReportId="@Model" asp-action="Submit" method="post">
          <div class="row">
            <div class="col-12">
              <p>Are you sure you want to submit this Salmonella Report?</p>
            </div>
          </div>
          <div class="row mt-2">
            <div class="col-12">
              <button type="submit" class="btn btn-afm-primary"><i class="fa fa-check"></i> Submit</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>