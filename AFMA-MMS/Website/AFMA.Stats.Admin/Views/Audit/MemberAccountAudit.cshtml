@model IEnumerable<AFMA.ApplicationLayer.ViewModels.MemberAccountAuditViewModel>

@{
  var modules = await ApplicationLayer.GetModules().ConfigureAwait(false);
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">System Admin</a></li>
    <li class="breadcrumb-item"><a href="#">Audit</a></li>
    <li class="breadcrumb-item active" aria-current="page">Member Account Audit</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Member Account Audit</h4>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
          <tr>
            <th scope="col" class="w-10">Member</th>
            <th scope="col" class="w-10">Member Account Branch</th>
            <th scope="col" class="w-10">Account Branch</th>
            <th scope="col" class="w-10">Account Active</th>
            <th scope="col" class="w-10">Email Address/Username</th>
            <th scope="col" class="w-10">Account Valid</th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var account in Model)
          {
            <tr>
              <td class="align-middle">@account.MemberName</td>
              <td class="align-middle">@Html.Raw(account.MemberBranchName)</td>
              <td class="align-middle">@account.MemberAccountBranchName</td>
                @if (account.MemberAccountActive)
                {
                  <td class="text-center align-middle"><i class="text-success fa-solid fa-2x fa-check"></i></td>
                }
                else
                {
                  <td class="text-center align-middle"><i class="text-danger fa-solid fa-2x fa-times"></i></td>
                }
              <td class="align-middle">@account.AccountEmailAddress</td>
                @if (account.MemberAccountValid)
                {
                  <td class="text-center align-middle"><i class="text-success fa-solid fa-2x fa-check"></i></td>
                }
                else
                {
                  <td class="text-center align-middle"><i class="text-danger fa-solid fa-2x fa-times"></i></td>
                }
               <td class="text-center">
                <a asp-action="AccountDetails" asp-controller="Member" asp-route-id="@account.MemberAccountId" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View Account</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>
</div>