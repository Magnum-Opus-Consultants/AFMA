<script src="~/vendor/dselect/dselect.js"></script>
<script src="~/vendor/apexcharts/apexcharts.js"></script>

<script>
  
  $(function () {
      
    $(".refresh-data").on('change', function (e) {
          // console.log($("#feedProducts").val());
          // console.log($("#feedReportPeriod").val());
          // console.log($("#feedYears").val());
          // console.log($("#feedMonths").val());

          var seriesData1 = @Html.Raw(seriesDataJson);
          console.log(seriesData1);
          seriesData = seriesData1.filter(x => x.Year === 2024);
          console.log(seriesData);
      });
  });

   new ApexCharts(document.querySelector('#feedProduced'), {
    chart: {
      type: 'bar',
      height: 260,
      toolbar: {
        show: false,
      }
    },
    colors: ['#facc15'],
    series: [{
        name: 'Feed Produced (tons)',
        data: @Html.Raw(seriesDataJson)
      },
    ],
    xaxis: {
      categories: @Html.Raw(seriesDataJson)
    },
    plotOptions: {
      bar: {
        columnWidth: '30%',
        borderRadius: 4,
      },
    },
    dataLabels: {
      enabled: false
    },
    legend: {
      show: false,
    }
  }).render()

    new ApexCharts(document.querySelector('#percentageChanged'), {
      chart: {
        type: 'bar',
        height: 260,
        toolbar: {
          show: false,
        }
      },
      colors: ['#6366f1'],
      series: [{
          name: '% change',
          data: [17, 32, 50, 47, 19, 11, 30, 40, 13, 11, 14, 66]
        },
      ],
      xaxis: {
        categories: @Html.Raw(categoriesJson)
      },
      plotOptions: {
        bar: {
          columnWidth: '30%',
          borderRadius: 4,
        },
      },
      dataLabels: {
        enabled: false
      },
      legend: {
        show: false,
      }
    }).render()

      new ApexCharts(document.querySelector('#rawMaterialUsed'), {
      series: @Html.Raw(rmSeriesDataJson),
      chart: {
        height: 360,
        type: 'donut',
        toolbar: {
          show: false,
        },
      },
      labels: @Html.Raw(labelsJson),
      dataLabels: {
        enabled: true,
      },
      legend: {
        show: true,        
        position: 'bottom'
      },
      stroke: {
        width: 0,
      },
      colors: ['#6366f1', '#0dcaf0', '#facc15', '#73b761', '#eb5757', '#002050', '#ae3535', '#b5dafe', '#262a76'],
    }).render()

        new ApexCharts(document.querySelector('#rawMaterialPercentageChanged'), {
      chart: {
        type: 'bar',
        height: 260,
        toolbar: {
          show: false,
        }
      },
      colors: ['#facc15', '#6366f1', '#eb5757'],
     series: [{
            name: 'Roughage',
          data: [17, 32, 50, 47, 19, 11, 30, 40, 13]
        },
        {
          name: 'Animal Protein Sources',
          data: [34, 65, 104, 94, 38, 23, 61, 80, 26]
        },
        {
          name: 'Fats and Oil',
          data: [134, 165, 40, 64, 138, 123, 161, 180, 126]
        },
      ],
      xaxis: {
        categories: @Html.Raw(categoriesJson)
      },
      plotOptions: {
        bar: {
          columnWidth: '30%',
          borderRadius: 4,
        },
      },
      dataLabels: {
        enabled: false
      },
      legend: {
        show: true,
        position: 'bottom'
      }
    }).render()


</script>