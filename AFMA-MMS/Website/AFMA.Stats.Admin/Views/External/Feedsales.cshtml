  </div>

  <div class="overflow-scroll overflow-x-hide col-lg-3 col-md-6 col-3">
    <div class="card">
      <div class="card-body">
        <div class="row">
          <div class="col-md-12">
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th scope="col">Period</th>
                    <th scope="col">Usage</th>
                    <th scope="col">Growth</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var period in Model.RmYearlyData.OrderByDescending(x => x.ReportYear))
                  {
                    <tr>
                      <td>@period.ReportYear</td>
