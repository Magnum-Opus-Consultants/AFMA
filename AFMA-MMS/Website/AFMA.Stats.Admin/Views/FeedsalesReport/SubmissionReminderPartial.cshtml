@model int

<div class="modal fade" id="feedsalesSubmissionReminder" tabindex="-1" aria-labelledby="feedsalesSubmissionReminderLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Send Reminder</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-id="@Model" asp-action="SendReminder" method="post">
          <div class="row">
            <div class="col-12">
              <p>Are you sure you want to send a reminder to this member?</p>
            </div>
          </div>
          <div class="row mt-2">
            <div class="col-12">
              <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Send Reminder</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>