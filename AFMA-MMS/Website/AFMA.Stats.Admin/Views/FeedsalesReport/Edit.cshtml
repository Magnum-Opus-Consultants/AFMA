@using System.Collections
@using AFMA.ApplicationLayer.Interface
@using AFMA.ApplicationLayer.Model
@using AFMA.Data.Entities
@using Microsoft.EntityFrameworkCore.Infrastructure
@model AFMA.ApplicationLayer.Model.FeedsalesReportModel
@inject IApplicationLayer ApplicationLayer
@inject IFeedsalesLayer FeedsalesLayer

<style scoped>
  .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
    color: #fff;
    background-color: #abad23;
  }
</style>

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Feedsales</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Report</li>
  </ol>
</nav>

<div class="row g-2 mt-2">
  <div class="col-9">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <h4>Edit Feedsales Reports</h4>
        </div>

        <div class="col-12">
          <div class="alert alert-info d-flex" role="alert">
            <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
            <div class="ms-3">
              <h6 class="text-reset">Important</h6>
              Remember to complete all the tabs (Feedsales and Raw Materials before submitting your report)
            </div>
          </div>
        </div>

        <ul class="nav nav-pills " id="feedsalesReportsTab">
          <li class="nav-item">
            <a class="nav-link active" href="#fp">Finished Products</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#rm">Raw Materials</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#summary">Summary</a>
          </li>
        </ul>
        <hr />

        <div class="tab-content" id="feedsaslesTabsContent">
          <div class="tab-pane fade show active" id="fp" role="tabpanel" aria-labelledby="feedsales-tab">
            <div class="accordion" id="accordionBasic">
              @foreach (var productGroup in await FeedsalesLayer.GetFinishedProductGroups())
              {
                <div class="accordion-item">
                  <h6 class="accordion-header" id="headingBasicOne-@productGroup.Id">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBasicOne-@productGroup.Id" aria-expanded="false" aria-controls="collapseBasicOne-@productGroup.Id">
                      <div class="d-flex flex-column">
                        <h6 class="text-reset">@productGroup.Name</h6>
                        <small class="text-secondary">@Model.ReportItems.Where(x => x.ProductGroupId == productGroup.Id).Sum(s => s.Value) tons</small>
                      </div>
                    </button>
                  </h6>
                  <div id="collapseBasicOne-@productGroup.Id" class="accordion-collapse collapse" aria-labelledby="headingBasicOne-@productGroup.Id" data-bs-parent="#accordionBasic">
                    <div class="accordion-body text-secondary">
                      <div class="col-12 pb-3">
                        <a class="btn btn-afm-primary" onclick="GetAvailableFinishedProducts(@productGroup.Id)"><i class="fa-solid fa-plus"></i> Add @productGroup.Name</a>
                      </div>
                      <table class="table table-bordered">
                        <thead class="table-secondary">
                          <tr>
                            <th scope="row" class="w-10">Code</th>
                            <th scope="row">Product</th>
                            <th scope="row" class="w-10">Amount</th>
                            <th scope="row" class="w-10">Previous</th>
                            <th scope="row" class="w-10"></th>
                          </tr>
                        </thead>
                        <tbody>
                          @foreach (var product in Model.ReportItems.Where(x => x.ProductGroupId == productGroup.Id))
                          {
                            <tr>
                              <td>@product.ProductCode</td>
                              <td>@product.Product @(!string.IsNullOrEmpty(product.Other) ? $" ({product.Other})" : "")</td>
                              <td>@product.Value</td>
                              <td>@product.PreviousValue</td>
                              <td class="text-center">
                                <button onclick="DeleteReportItemId(@product.Id, 'fp')" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</button>
                              </td>
                            </tr>
                          }
                        </tbody>
                      </table>

                    </div>
                  </div>
                </div>
              }
            </div>
          </div>
          <div class="tab-pane fade" id="rm" role="tabpanel" aria-labelledby="rawmaterial-tab">
            <div class="col-12 pb-3">
              <a class="btn btn-afm-primary" onclick="GetAvailableRawMaterials()"><i class="fa-solid fa-plus"></i> Add Raw Material</a>
            </div>
            <table class="table table-bordered">
              <thead class="table-secondary">
                <tr>
                  <th scope="row" class="w-10">Code</th>
                  <th scope="row">Material</th>
                  <th scope="row" class="w-10">Amount</th>
                  <th scope="row" class="w-10">Previous</th>
                  <th scope="row" class="w-10"></th>
                </tr>
              </thead>
              <tbody>
                @foreach (var material in Model.ReportItems.Where(x => x.MaterialId != null))
                {
                  <tr>
                    <td>@material.MaterialCode</td>
                    <td>@material.Material @(!string.IsNullOrEmpty(material.Other) ? $" ({material.Other})" : "")</td>
                    <td>@material.Value</td>
                    <td>@material.PreviousValue</td>
                    <td class="text-center">
                      <button onclick="DeleteReportItemId(@material.Id, 'rm')" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="tab-pane fade" id="summary" role="tabpanel" aria-labelledby="summary-tab">
            <form asp-controller="FeedsalesReport" asp-action="Edit" asp-route-feedsalesReportId="@Model.Id" method="post">
              <div classs="row">
                <div class="col-12">
                  <table class="table table-bordered">
                    <tr>
                      <th scope="row" class="w-25">(A) Total Raw Material Usage</th>
                      <td>@Model.RawMaterialTotal</td>
                    </tr>
                    <tr>
                      <th scope="row" class="w-25">(B) Total Finished Product Usage</th>
                      <td>@Model.FinishedProductTotal</td>
                    </tr>
                    <tr>
                      <th scope="row" class="w-25">Difference Between (A) and (B)</th>
                      <td>@Model.Variance %</td>
                    </tr>
                    <tr>
                      <th scope="row" class="w-25">Reason For Difference</th>
                      <td>
                        <textarea rows="3" asp-for="DifferenceReason" class="form-control"></textarea>
                      </td>
                    </tr>
                    <tr>
                      <th scope="row" class="w-25">Comment</th>
                      <td>
                        <input asp-for="Comment" class="form-control" />
                      </td>
                    </tr>
                  </table>
                </div>
              </div>

              <div class="row mt-2 pull-right">
                <div class="col-12">
                  <button type="submit" class="btn btn-success"><i class="fa-solid fa-save"></i> Save</button>
                  @if (Model.IsSubmitted)
                  {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#unsubmitFeedsalesReport"><i class="fa-solid fa-arrow-down"></i> Unsubmit</button>
                  }
                  else
                  {
                    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#submitFeedsalesReport"><i class="fa-solid fa-arrow-up"></i> Submit</button>
                  }
                  <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteFeedsalesReport"><i class="fa-solid fa-trash"></i> Delete</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-3">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Feedsales Total</h4>
        <p style="font-size: 1.8rem" class="fw-bold text-center">@Model.FinishedProductTotal tons</p>
      </div>
    </div>
    <div class="card mt-2">
      <div class="card-body">
        <h4 class="card-title">Raw Material Total</h4>
        <p style="font-size:1.8rem" class="fw-bold text-center">@Model.RawMaterialTotal tons</p>
      </div>
    </div>
    <div class="card mt-2">
      <div class="card-body">
        <h4 class="card-title">Variance</h4>
        <p style="font-size:1.8rem" class="fw-bold text-center">@Model.Variance %</p>
      </div>
    </div>

  </div>
</div>

<div class="modal fade" id="addRawMaterial" tabindex="-1" aria-labelledby="addRawMaterialLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4" id="addRawMaterialLabel">Add Raw Material</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="needs-validation" novalidate asp-action="AddRawMaterial" method="post">
          <input type="hidden" asp-for="Id" class="form-control" />
          <input type="hidden" asp-for="MemberAccountId" class="form-control" />
          <input type="hidden" asp-for="MemberBranchId" class="form-control" />
          <input type="hidden" asp-for="MemberId" class="form-control" />
          <div class="row">
            <div class="col-10">
              <div class="form-group">
                <label class="form-label">Material</label>
                <select id="TMaterialId" name="TMaterialId" class="form-control" required></select>
              </div>
            </div>
            <div class="col-2">
              <div class="form-group">
                <label class="form-label">Value</label>
                <input asp-for="TAmount" class="form-control" required />
                <div class="invalid-feedback">Value is required.</div>
              </div>
            </div>
          </div>
          
          <div class="row mt-2" id="showAlertMessage" style="display: none">
            <div class="col-12 mt-2">
              <div class="alert alert-danger">
                <p><i class="fa fa-exclamation-circle fa-2x"></i> <strong><span id="alertMessage"></span></strong></p>
              </div>
            </div>
          </div>

          <div class="row mt-2" id="otherMaterialRequired" style="display: none">
            <div class="col-12 mt-2">
              <div class="alert alert-warning">
                <p><i class="fa fa-bullhorn fa-2x"></i> The Raw Material you selected requires more information. Please complete the field below. <strong>Note that you can add multiple entries for this Finished Product.</strong></p>
              </div>
            </div>
            <div class="col-12">
              <div class="form-group">
                <label class="form-label"><span id="otherMaterialName">Value</span></label>
                <input asp-for="TMOther" class="form-control" required />
                <div class="invalid-feedback">Other description is required.</div>
              </div>
            </div>
          </div>
          <div class="row mt-3">
            <div class="col-12">
              <button type="submit" class="btn btn-afm-primary"><i class="fa fa-plus"></i> Add</button>
            </div>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="addFinishedProduct" tabindex="-1" aria-labelledby="addFinishedProductLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4" id="addFinishedProductLabel">Add Finished Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="needs-validation" novalidate asp-action="AddFinishedProduct" method="post">
          <input type="hidden" asp-for="Id" class="form-control" />
          <input type="hidden" asp-for="MemberAccountId" class="form-control" />
          <input type="hidden" asp-for="MemberBranchId" class="form-control" />
          <input type="hidden" asp-for="MemberId" class="form-control" />
          <div class="row">
            <div class="col-10">
              <div class="form-group">
                <label class="form-label">Product</label>
                <select id="TProductId" name="TProductId" class="form-control" required></select>
                <div class="invalid-feedback">Product is required.</div>
              </div>
            </div>
            <div class="col-2">
              <div class="form-group">
                <label class="form-label">Value</label>
                <input asp-for="TAmount" class="form-control" required />
                <div class="invalid-feedback">Value is required.</div>
              </div>
            </div>
          </div>

          <div class="row mt-2" id="otherProductRequired" style="display: none">
            <div class="col-12 mt-2">
              <div class="alert alert-warning">
                <p><i class="fa fa-bullhorn fa-2x"></i> The Finished Product you selected requires more information. Please complete the field below. <strong>Note that you can add multiple entries for this Finished Product.</strong></p>
              </div>
            </div>
            <div class="col-12">
              <div class="form-group">
                <label class="form-label"><span id="otherProductName">Value</span></label>
                <input asp-for="TPOther" class="form-control" required />
                <div class="invalid-feedback">Other description is required.</div>
              </div>
            </div>
          </div>
          <div class="row mt-3">
            <div class="col-12">
              <button type="submit" class="btn btn-afm-primary"><i class="fa fa-plus"></i> Add</button>
            </div>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>

<partial name="SubmitReportPartial" model="@Model.Id" />

<partial name="UnsubmitReportPartial" model="@Model.Id" />

<partial name="DeleteReportPartial" model="@Model.Id" />

<partial name="DeleteReportItemPartial" model="@Model.Id" />

<script>

  $(document).ready(function () {

    $('#feedsalesReportsTab a').click(function (e) {
      e.preventDefault();
      $(this).tab('show');
    });

    $("ul.nav-tabs > li > a").on("shown.bs.tab", function (e) {
      var id = $(e.target).attr("href").substr(1);
      window.location.hash = id;
    });

    var hash = window.location.hash;
    $('#feedsalesReportsTab a[href="' + hash + '"]').tab('show');

  });

  $("select#TProductId").change(function () {
    var pid = $(this).val();
    $.getJSON(`/General/FinishedProduct/IsOtherFinishedProduct?productId=${pid}`,
      function (data) {
        if (data.other === true) {
          $("#otherProductName").text("Name of " + data.name + " (Required)");
          $("#TPOther").attr("required");
          $("#otherProductRequired").show();
        } else {
          $("#otherProductRequired").hide();
          $("#TPOther").removeAttr("required");
        }
      });
  });

  $("select#TMaterialId").change(function () {
    var mid = $(this).val();
    $.getJSON(`/General/RawMaterial/IsOtherRawMaterial?materialId=${mid}`,
      function (data) {
        if (data.other === true) {
          $("#otherMaterialName").text("Name of " + data.name + " (Required)");
          $("#TMOther").attr("required");
          $("#otherMaterialRequired").show();
        } else {
          $("#otherMaterialRequired").hide();
          $("#TMOther").removeAttr("required");
        }

        if (data.showAlert === true) {
          $("#alertMessage").text(data.alertMessage);
          $("#showAlertMessage").show();
        } else {
          $("#showAlertMessage").hide();
          $("#alertMessage").text("");
        }
      });
  });

  function GetAvailableFinishedProducts(productGroupId) {

    var feedsalesReportId = @Model.Id;

    $.ajax({
      type: "GET",
      url: "/General/FinishedProduct/GenerateFinishedProductSelectList",
      data: { productGroupId: productGroupId, feedsalesReportId: feedsalesReportId },
      success: function (result) {
        var s = '<option value="">-- Select a Finished Product --</option>';
        for (var i = 0; i < result.length; i++) {
          s += '<option value="' + result[i].id + '">' + result[i].name + '</option>';
        }
        $("#TProductId").html(s);
      }
    });
    $("#addFinishedProduct").modal("show");
  }

  function GetAvailableRawMaterials() {

    var feedsalesReportId = @Model.Id;

    $.ajax({
      type: "GET",
      url: "/General/RawMaterial/GenerateRawMaterialSelectList",
      data: { materialCategoryId: 0, feedsalesReportId: feedsalesReportId },
      success: function (result) {
        var s = '<option value="">-- Select a Raw Material --</option>';
        for (var i = 0; i < result.length; i++) {
          s += '<option value="' + result[i].id + '">' + result[i].name + '</option>';
        }
        $("#TMaterialId").html(s);
      }
    });

    $("#addRawMaterial").modal("show");
  }

  function DeleteReportItemId(reportItemId, reportItemType) {
    $("#deleteFeedsalesReportItem").modal("show");
    $("#TReportItemId").val(reportItemId);
    $("#TReportItemType").val(reportItemType);
  }

</script>