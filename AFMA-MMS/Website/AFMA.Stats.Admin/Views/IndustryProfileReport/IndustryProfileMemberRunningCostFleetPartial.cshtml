@model IEnumerable<AFMA.ApplicationLayer.Model.MemberRunningCostFleetModel>

@{
  var id = Convert.ToInt32(ViewData["IndustryProfileReportId"]);
}

<div class="row">
  <div class="col-md-12">

    <div style="width:100%;text-align:center"><h4><strong>RENTED FLEET - RUNNING COST</strong></h4></div><br />

    <table class="table table-responsive table-striped table-sm table-bordered">
      <tr>
        <th class="td-afm-secondary td-w-5">Code</th>
        <th class="td-afm-secondary">Item</th>
        <th class="td-afm-secondary td-w-15 text-center">Note</th>
        <th class="td-afm-secondary td-w-15">Total Cost</th>
      </tr>

      @foreach (var item in Model)
      {
        <tr>
          <td>@item.RunningCostRentedFleetCode</td>
          <td>@item.RunningCostRentedFleet</td>
          <td></td>
          <td>@($"{item.Value:c}")</td>
        </tr>
      }

      <tr>
        <th class="td-afm-secondary"></th>
        <th class="td-afm-secondary">TOTAL</th>
        <th class="td-afm-secondary"></th>
        <th class="td-afm-secondary" style="text-align:right">@($"{Model.Sum(a => a.Value):c}")</th>
      </tr>
    </table>
  </div>
</div>

<div class="row g-2">
  <div class="col-12">
    <div style="float: right" class="mt-2">
      <a asp-controller="IndustryProfileReport" asp-action="EditIndustryCostFleet" asp-route-id="@id" class="btn btn-afm-default"><i class="fa-regular fa-edit"></i> Edit</a>
    </div>
  </div>
</div>