@using AFMA.Stats.Client.Models
@model ErrorViewModel

@{
  ViewBag.Title = "500 Error Page";
}


<div class="my-5 pt-sm-5">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="text-center">
          <div>
            <div class="row justify-content-center">
              <div class="col-sm-5">
                <div class="">
                  <img src="~/assets/images/server-error.png" alt="" class="img-fluid mx-auto d-block">
                </div>
              </div>
            </div>
          </div>
          <h4 class="text-uppercase mt-4">@Model.ErrorTitle</h4>
          <p class="text-muted">@Model.ExceptionMessage</p>
          @if (!string.IsNullOrEmpty(Model.InnerExceptionMessage))
          {
            <p class="text-muted">@Model.InnerExceptionMessage</p>
          }
          <p class="text-muted">Path: @Model.Path</p>
          <div class="mt-5">
            <a class="btn btn-primary waves-effect waves-light" href=@Url.Action("Index", "Home")>Back to Dashboard</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>