@{
  var controllerActive = !string.IsNullOrEmpty(ViewBag.Controller) && string.IsNullOrEmpty(ViewBag.Action) ? "active" : "";
}
<div class="row">
  <div class="col-12">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
      <h4 class="mb-sm-0 font-size-18">@ViewBag.PageTitle</h4>

      <div class="page-title-right">
        <ol class="breadcrumb m-0">
          <li class="breadcrumb-item"><a href="javascript: void(0);">@ViewBag.Home</a></li>
          <li class="breadcrumb-item @controllerActive">@ViewBag.Controller</li>
          @if (!string.IsNullOrEmpty(ViewBag.Action))
          {
            <li class="breadcrumb-item active">@ViewBag.Action</li>
          }
        </ol>
      </div>

    </div>
  </div>
</div>