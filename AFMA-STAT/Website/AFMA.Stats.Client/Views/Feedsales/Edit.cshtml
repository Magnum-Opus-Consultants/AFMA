@model AFMA.ApplicationLayer.Model.FeedsalesReportModel

@{
  ViewBag.PageTitle = "Feedsales";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Feedsales";
  ViewBag.Action = "Edit Report";
}

<div class="row">
  <div class="col-8">
    <div class="card">
      <div class="card-body">
        
        @if (!Model.IsSubmitted)
        {
          <h4 class="card-title">Edit Feedsales Report</h4>
          <p class="card-title-desc">Edit the basic information on a feedsales report.</p>

          <form class="needs-validation" novalidate method="post" asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReportMonth"/>
            <input type="hidden" asp-for="ReportYear" />
            <input type="hidden" asp-for="MemberId" />
            <input type="hidden" asp-for="MemberBranchId" />
            <input type="hidden" asp-for="MemberAccountId" />

            <div class="row">
              <div class="col-6 mb-3">
                <label asp-for="Id" class="form-label"></label>
                <input asp-for="Id" class="form-control" readonly>
              </div>
              <div class="col-6 mb-3">
                <label asp-for="SubmittedDate" class="form-label"></label>
                @Html.TextBoxFor(model => model.SubmittedDate, "{0:dd/MM/yyyy}", new { @class = "form-control", disabled = "disabled" })
              </div>
            </div>

            <div class="row">
              <div class="col-6 mb-3">
                <label asp-for="Member" class="form-label"></label>
                <input asp-for="Member" class="form-control" readonly>
              </div>
              <div class="col-6 mb-3">
                <label asp-for="MemberBranch" class="form-label"></label>
                <input asp-for="MemberBranch" class="form-control" readonly>
              </div>
            </div>

            <div class="row">
              <div class="col-6 mb-3">
                <label asp-for="MemberAccount" class="form-label"></label>
                <input asp-for="MemberAccount" class="form-control" readonly>
              </div>
              <div class="col-6 mb-3">
                <label asp-for="InfoFor" class="form-label"></label>
                @Html.TextBoxFor(model => model.InfoFor, "{0:MMMM yyyy}", new { @class = "form-control", disabled = "disabled" })
              </div>
            </div>

            <div class="row">
              <div class="col-12 mb-3">
                <label asp-for="DifferenceReason" class="form-label"></label>
                <textarea rows="3" asp-for="DifferenceReason" class="form-control"></textarea>
              </div>
            </div>

            <div class="row">
              <div class="col-12 mb-3">
                <label asp-for="Comment" class="form-label"></label>
                <textarea rows="3" asp-for="Comment" class="form-control"></textarea>
              </div>
            </div>

            <div style="float: left">
              <a asp-controller="Feedsales" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="fa fa-arrow-left"></i> Back</a>
            </div>

            <div style="float: right">
              @if (!Model.IsSubmitted)
              {
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
              }
            </div>
          </form>
        }
        else
        {
          <div class="col-12">
            <div class="card border border-danger mb-lg-0">
              <div class="card-header bg-transparent border-danger">
                <h5 class="my-0 text-danger text-truncate"><i class="mdi mdi-block-helper me-3"></i>Edit Feedsales Report</h5>
              </div>
              <div class="card-body">
                <h5 class="card-title mt-0">Cannot edit report</h5>
                <p class="card-text">Submitted feedsales reports cannot be edited. Contact AFMA to make alterations to this report.</p>
              </div>
            </div>
            <div class="mt-3" style="float: left">
              <a asp-controller="Feedsales" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="fa fa-arrow-left"></i> Back</a>
            </div>
          </div>
        }

      </div>
    </div>
  </div>

  <div class="col-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h4 class="card-title">Total Finished Products</h4>
          <p class="card-title-desc">Displays the total finished products for this report compared to the previous month.</p>
          <h1 style="font-size:1.8rem" class="text-center">@Model.ProductsCurrentMonth tons</h1>
          <p class="card-text">Previous Month: @Model.ProductsPreviousMonth tons</p>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h4 class="card-title">Total Raw Materials</h4>
          <p class="card-title-desc">Displays the total raw materials for this report compared to the previous month.</p>
          <h1 style="font-size:1.8rem" class="text-center">@Model.MaterialsCurrentMonth tons</h1>
          <p class="card-text">Previous Month: @Model.MaterialsPreviousMonth tons</p>

        </div>
      </div>
    </div>
  </div>
</div>