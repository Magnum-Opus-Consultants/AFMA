@using AFMA.ApplicationLayer.Helpers
@model AFMA.ApplicationLayer.Model.FeedsalesReportModel

@{
  ViewBag.PageTitle = "Feedsales";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Feedsales";
  ViewBag.Action = "View Report";
}

<div class="row">
  <div class="col-8">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">View Feedsales Report</h4>
        <p class="card-title-desc">Displays your feedsales report with a summary of all items submitted.</p>

        <div class="row">
          <div class="col-6 mb-3">
            <label asp-for="Id" class="form-label"></label>
            <input asp-for="Id" class="form-control" readonly>
          </div>
          <div class="col-6 mb-3">
            <label asp-for="SubmittedDate" class="form-label"></label>
            @Html.TextBoxFor(model => model.SubmittedDate, "{0:dd/MM/yyyy}", new { @class = "form-control", disabled = "disabled" })
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <label asp-for="Member" class="form-label"></label>
            <input asp-for="Member" class="form-control" readonly>
          </div>
          <div class="col-6 mb-3">
            <label asp-for="MemberBranch" class="form-label"></label>
            <input asp-for="MemberBranch" class="form-control" readonly>
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <label asp-for="MemberAccount" class="form-label"></label>
            <input asp-for="MemberAccount" class="form-control" readonly>
          </div>
          <div class="col-6 mb-3">
            <label asp-for="InfoFor" class="form-label"></label>
            @Html.TextBoxFor(model => model.InfoFor, "{0:MMMM yyyy}", new { @class = "form-control", disabled = "disabled" })
          </div>
        </div>

        <div class="row">
          <div class="col-12 mb-3">
            <label asp-for="DifferenceReason" class="form-label"></label>
            <textarea rows="3" asp-for="DifferenceReason" class="form-control" readonly></textarea>
          </div>
        </div>

        <div class="row">
          <div class="col-12 mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea rows="3" asp-for="Comment" class="form-control" readonly></textarea>
          </div>
        </div>


        <div style="float: left" class="mt-3">
          <a asp-controller="Feedsales" asp-action="Index" class="btn btn-outline-dark"><i class="fa fa-arrow-left"></i> Back</a>
        </div>

        <div style="float: right" class="mt-3">
          @if (!Model.IsSubmitted)
          {
            <a asp-controller="Feedsales" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Edit</a>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#submitFeedsalesReport"><i class="fa fa-arrow-up"></i> Submit</button>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="col-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h4 class="card-title">Total Finished Products</h4>
          <p class="card-title-desc">Displays the total finished products for this report compared to the previous month.</p>
          <h1 style="font-size:1.8rem" class="text-center">@Model.ProductsCurrentMonth tons</h1>
          <p class="card-text">Previous Month: @Model.ProductsPreviousMonth tons</p>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h4 class="card-title">Total Raw Materials</h4>
          <p class="card-title-desc">Displays the total raw materials for this report compared to the previous month.</p>
          <h1 style="font-size:1.8rem" class="text-center">@Model.MaterialsCurrentMonth tons</h1>
          <p class="card-text">Previous Month: @Model.MaterialsPreviousMonth tons</p>

        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Finished Product Submission</h4>
        <table class="table table-bordered">
          <thead class="table-secondary">
            <tr>
              <th scope="col" class="w-5">Code</th>
              <th scope="col">Finished Product</th>
              <th scope="col" class="w-10">This Month</th>
              <th scope="col" class="w-10">Previous</th>
              <th scope="col" class="w-10">Difference</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var product in Model.ReportItems.Where(x => x.ProductId.HasValue))
            {
              var previousValue = Model.ReportItemsPreviousMonth.Where(x => x.ProductId == product.ProductId).Sum(s => s.Value);
              var percentage = GeneralHelpers.GetPercentageIncreaseOrDecrease(product.Value, previousValue);

              <tr>
                <td>@product.ProductCode</td>
                <td>@product.Product</td>
                <td>@product.Value</td>
                <td>@previousValue</td>
                @if (previousValue < product.Value)
                {
                  <td style="color: red">
                    <span><i class="fa fa-arrow-down"></i></span>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
                else if (previousValue == 0)
                {
                  <td>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
                else
                {
                  <td style="color: green">
                    <span><i class="fa fa-arrow-up"></i></span>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>

        <h4 class="card-title mt-4">Raw Material Submission</h4>
        <table class="table table-bordered">
          <thead class="table-secondary">
            <tr>
              <th scope="col" class="w-5">Code</th>
              <th scope="col">Raw Material</th>
              <th scope="col" class="w-10">This Month</th>
              <th scope="col" class="w-10">Previous</th>
              <th scope="col" class="w-10">Difference</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var material in Model.ReportItems.Where(x => x.MaterialId.HasValue))
            {
              var previousValue = Model.ReportItemsPreviousMonth.Where(x => x.MaterialId == material.MaterialId).Sum(s => s.Value);
              var percentage = GeneralHelpers.GetPercentageIncreaseOrDecrease(material.Value, previousValue);

              <tr>
                <td>@material.MaterialCode</td>
                <td>@material.Material</td>
                <td>@material.Value</td>
                <td>@previousValue</td>
                @if (previousValue < material.Value)
                {
                  <td style="color: red">
                    <span><i class="fa fa-arrow-down"></i></span>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
                else if (previousValue == 0)
                {
                  <td>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
                else
                {
                  <td style="color: green">
                    <span><i class="fa fa-arrow-up"></i></span>
                    <span class="pull-right">@($"{percentage:0.00} %")</span>
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>

      </div>
    </div>
  </div>
</div>

<partial name="SubmitReportPartial" model="@Model.Id" />