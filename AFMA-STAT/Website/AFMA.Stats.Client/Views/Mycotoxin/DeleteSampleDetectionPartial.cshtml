@model AFMA.ApplicationLayer.Model.NotificationModel

<div class="modal fade" id="deleteSampleDetectionConfirm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="deleteSalmpleDetectionCnfirmLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteSalmpleDetectionCnfirmLabel">Delete Mycotoxin Sample Detection</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form asp-route-sampleId="@Model.SampleId" asp-route-reportId="@Model.ReportId" asp-controller="Mycotoxin" asp-action="DeleteSampleDetection" method="post">
        <input type="hidden" id="sampleDetectionId" name="sampleDetectionId" />
        <div class="row">
          <div class="col-12">
            <p>Confirm that this detection is to be removed.</p>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
          <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>