@using Resolvetech.NetCore.Common.Helpers
@using AFMA.ApplicationLayer.Helpers
@using AFMA.ApplicationLayer.Model
@model AFMA.ApplicationLayer.Model.MycotoxinReportModel

@{
  ViewBag.PageTitle = "Mycotoxins";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Mycotoxins";
  ViewBag.Action = "View Report";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Manage Mycotoxin Report</h4>
        <p class="card-title-desc">Manages your mycotoxin report with a summary of all items submitted.</p>

        <div class="row">
          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="Id" class="form-label"></label>
              <input asp-for="Id" class="form-control" disabled />
            </div>
          </div>

          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="Member" class="form-label"></label>
              <input asp-for="Member" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="LaboratoryReportNo" class="form-label"></label>
              <input asp-for="LaboratoryReportNo" class="form-control" disabled />
            </div>
          </div>

          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="MemberBranch" class="form-label"></label>
              <input asp-for="MemberBranch" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="SubmittedDate" class="form-label"></label>
              @Html.TextBoxFor(model => model.SubmittedDate, "{0:dd/MM/yyyy}", new { @class = "form-control", disabled = "disabled" })
            </div>
          </div>

          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="MemberAccount" class="form-label"></label>
              <input asp-for="MemberAccount" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="Laboratory" class="form-label"></label>
              <input asp-for="Laboratory" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="DueDate" class="form-label"></label>
              @Html.TextBoxFor(model => model.DueDate, "{0:dd/MM/yyyy}", new { @class = "form-control", disabled = "disabled" })
            </div>
          </div>

          <div class="col-6 mb-3">
            <div class="form-group">
              <label asp-for="InfoFor" class="form-label"></label>
              @Html.TextBoxFor(model => model.InfoFor, "{0:MMMM yyyy}", new { @class = "form-control", disabled = "disabled" })
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12 mb-3">
            <div class="form-group">
              <label asp-for="Comment" class="form-label"></label>
              <textarea rows="3" asp-for="Comment" class="form-control" disabled></textarea>
            </div>
          </div>
        </div>

        <div style="float: left" class="mt-2">
          <a asp-controller="Mycotoxin" asp-action="Index" class="btn btn-outline-dark"><i class="fa fa-arrow-left"></i> Back</a>
        </div>

        <div style="float: right" class="mt-2">

          @if (!Model.IsSubmitted)
          {
            <a asp-controller="Mycotoxin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Edit</a>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#submitMycotoxinReport"><i class="fa fa-arrow-up"></i> Submit</button>
          }
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-2 mt-2">
  <div class="col-12">
    <div class="alert alert-info d-flex" role="alert">
      <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
      </svg>
      <div class="ms-3">
        <h6 class="text-reset">Important</h6>
        At least one sample must be added below in order to successfully submit the Mycotoxin report.
      </div>
    </div>
  </div>
</div>

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Samples submitted for analysis</h4>
        @if (!Model.IsSubmitted)
        {
          <div class="col-12 pb-3 pt-3">
            <a asp-controller="Mycotoxin" asp-action="CreateSample" asp-route-mycotoxinReportId="@Model.Id" class="btn btn-primary"><i class="fa fa-plus"></i> Add New Sample</a>
          </div>
        }
        <table class="table table-bordered">
          <thead class="table-secondary">
            <tr>
              <th style="width:5%">Id</th>
              <th style="width:10%">Sample Type</th>
              <th style="width:20%">Raw Material/Finished Product</th>
              <th style="width:15%">Raw Material Origin</th>
              <th>Notes</th>
              <th style="width:10%"></th>
              @if (!Model.IsSubmitted)
              {
                <th style="width:8%"></th>
              }

            </tr>
          </thead>
          <tbody>
            @foreach (var sample in Model.Samples)
            {
              <tr>
                <td>@sample.Id</td>
                <td>@sample.MycotoxinSampleType</td>
                <td>
                  @if (sample.MycotoxinSampleTypeId == (int)MycotoxinSampleTypeEnum.RawMaterial)
                  {
                    @sample.Material
                  }
                  @if (sample.MycotoxinSampleTypeId == (int)MycotoxinSampleTypeEnum.FinishedProduct)
                  {
                    @sample.Product
                  }
                </td>
                <td>@sample.MaterialOrigin</td>
                <td>@sample.Note</td>
                <td class="text-center">
                  @if (sample.MycotoxinDetected)
                  {
                    <span class="afm-badge bg-danger">DETECTED</span>
                  }
                  else
                  {
                    <span class="afm-badge bg-success">NOT DETECTED</span>
                  }
                </td>
                @if (!Model.IsSubmitted)
                {
                  <td class="text-center">
                    <a asp-controller="Mycotoxin" asp-action="ViewSample" asp-route-id="@sample.Id" asp-route-mycotoxinReportId="@Model.Id" class="btn btn-primary btn-sm"><i class="fa fa-eye"></i> View</a>
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<partial name="DeleteSamplePartial" model="@(new NotificationModel{SampleId = Model.Id, ReportId = Model.Id})" />

<partial name="SubmitReportPartial" model="@Model.Id" />