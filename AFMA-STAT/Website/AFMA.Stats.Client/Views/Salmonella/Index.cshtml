@using X.PagedList
@using X.PagedList.Mvc.Core
@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.SalmonellaReportLookupModel>

@{
  ViewBag.PageTitle = "Salmonella";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Salmonella";
  ViewBag.Action = "Reports";
  var filterIsSubmitted = Context.Request.Query["filterIsSubmitted"].ToNullableBool();
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Salmonella Reports</h4>
        <p class="card-title-desc">
          Displays a list of all outstanding and submitted salmonella reports.
        </p>

        <div class="table-responsive">
          <table class="table table-bordered table-striped mb-0">

            <thead>
              <tr>
                <th>Member</th>
                <th class="w-25">Branch</th>
                <th class="w-15">Info For</th>
                <th class="w-10 text-center">Report No</th>
                <th class="w-10 text-center">Status</th>
                <th class="w-15"></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model)
              {
                <tr>
                  <td scope="row">@item.Member</td>
                  <td>@item.MemberBranch</td>
                  <td>@item.InfoFor.ToString("MMMM yyyy")</td>
                  <td class="text-center">@item.Id</td>
                  <td class="text-center align-middle">
                    @if (item.IsSubmitted)
                    {
                      <span class="afm-badge bg-success">SUBMITTED</span>
                    }
                    else
                    {
                      <span class="afm-badge bg-danger">OUTSTANDING</span>
                    }
                  </td>
                  <td class="text-center">
                    <a asp-controller="Salmonella" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm waves-effect waves-light"><i class="fas fa-eye"></i> View</a>
                    <a asp-controller="Salmonella" asp-action="Manage" asp-route-id="@item.Id" class="btn btn-info btn-sm waves-effect waves-light @((item.IsSubmitted) ? "disabled" : "")" title="Allows you to edit this report and add samples and detection. Submitted reports can not be managed"><i class="fas fa-edit"></i> Manage</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>

        @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterIsSubmitted }))

      </div>
    </div>
  </div>
</div>

