@model AFMA.ApplicationLayer.ViewModels.CompanyIndustryProfileViewModel

@{
  ViewBag.PageTitle = "Industry Profile";
  ViewBag.Home = "Home";
  ViewBag.Controller = "Industry Profile";
  ViewBag.Action = "Edit Report";
  var groups = IndustryProfileLayer.GetPcbCostSubGroups(false).Result.Where(x => x.PcbCostMainGroupId == Model.MemberPcbCostItems.First().PcbCostMainGroupId).ToList();
}

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Edit @groups.FirstOrDefault()?.SubGroupName</h4>
        <p class="card-title-desc">Edit your industry profile report data.</p>

        <form class="needs-validation" novalidate asp-action="EditPcbCost" method="post">
          <input asp-for="IndustryProfileReportId" type="hidden" />
          <input asp-for="MemberId" type="hidden" />
          <input asp-for="MemberBranchId" type="hidden" />
          <input asp-for="MemberTypeId" type="hidden" />
          <input id="PcbMainGroupId" name="PcbMainGroupId" type="hidden" value="@Model.MemberPcbCostItems.First().PcbCostMainGroupId" />

          <div class="row">
            <div class="col-12">
              @foreach (var subGroup in groups)
              {
                foreach (var itemGroup in subGroup.PcbCostItemGroups.Where(x => x.Active))
                {
                  <table class="table table-responsive table-sm table-bordered">
                    <tr>
                      <th class="td-afm-secondary" colspan="3" style="width:100%">@($"{itemGroup.ItemGroupCode} {itemGroup.ItemGroupName}")</th>
                    </tr>
                    <tr>
                      <td style="text-align:left" colspan="3">
                        <p>@itemGroup.ItemGroupHelpText</p>
                      </td>
                    </tr>

                    @foreach (var item in Model.MemberPcbCostItems.Where(x => x.PcbCostItemGroupId == itemGroup.Id))
                    {
                      <tr>
                        <td class="td-w-30">
                          @($"* {item.ItemDescription}")
                        </td>
                        <td class="td-w-25">
                          @if (item.Readonly)
                          {
                            @("XXX")
                          }
                          else
                          {
                            <input type="text" id="PCBCostItem_@item.Id" name="PCBCostItem_@item.Id" class="form-control" value="@item.Value" />
                          }
                        </td>
                        <td></td>
                      </tr>
                    }
                  </table>
                }
              }
            </div>
          </div>

          <hr />
          <div style="float: right">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
            <a asp-action="Details" asp-controller="IndustryProfile" asp-route-id="@Model.IndustryProfileReportId" class="btn btn-secondary"><i class="fa fa-times"></i> Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>