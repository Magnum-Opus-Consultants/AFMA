@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.MemberIpAdditionalItemModel>

@{
  var groups = await ApplicationLayer.GetIpAdditionalGroups(false).ConfigureAwait(false);
  var id = Convert.ToInt32(ViewData["IndustryProfileReportId"]);
  Enum.TryParse(ViewData["CurrentPageAction"]?.ToString(), out CurrentPageAction currentPageAction);
}

<div class="row g-2">
  <div class="col-md-12">
    @foreach (var group in groups)
    {
      <table class="table table-responsive table-sm table-bordered">
        <tr>
          <th class="td-afm-secondary td-w-5"></th>
          <th class="td-afm-secondary"></th>
          <th class="td-afm-secondary td-w-20 text-center"><strong>(@group.GroupMeasure)</strong></th>
          <th class="td-afm-secondary td-w-30">REPLACEMENT VALUE (RAND)</th>
        </tr>
        <tr>
          <th class="td-afm-secondary"><strong>@group.GroupCode</strong></th>
          <th class="td-afm-secondary"><strong>@group.GroupName</strong></th>
          <th class="td-afm-secondary"><strong>@($"{Model.Where(x => x.IpAdditionalGroupId == group.Id).Sum(x => x.Value):0}")</strong></th>
          <th class="td-afm-secondary"></th>
        </tr>

        @foreach (var item in Model.Where(x => x.IpAdditionalGroupId == group.Id))
        {
          <tr>
            <td></td>
            <td>@item.ItemDescription</td>
            <td>@($"{item.Value:0}")</td>
            <td>@item.Description</td>
          </tr>
        }

      </table>
    }
  </div>
</div>

@if (currentPageAction == CurrentPageAction.Manage)
{
  <div class="row g-2">
    <div class="col-12">
      <div style="float: right" class="mt-2">
        <a asp-controller="IndustryProfile" asp-action="EditIndustryProfileAdditional" asp-route-id="@id" class="btn btn-primary"><i class="fa fa-edit"></i> Edit</a>
      </div>
    </div>
  </div>
}