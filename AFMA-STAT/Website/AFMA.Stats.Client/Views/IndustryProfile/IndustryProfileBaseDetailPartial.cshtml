@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.MemberIpBaseItemModel>

@{
  var groups = await ApplicationLayer.GetIpBaseGroups(false).ConfigureAwait(false);
  var id = Convert.ToInt32(ViewData["IndustryProfileReportId"]);
  var currentPage =  Convert.ToInt32(ViewData["CurrentPage"]);
  Enum.TryParse(ViewData["CurrentPageAction"]?.ToString(), out CurrentPageAction currentPageAction);
}

<div class="row g-2">
  <div class="col-12">

    @foreach (var group in groups)
    {
      <table class="table table-responsive table-sm table-bordered">
        <tr>
          <th class="td-afm-secondary td-w-5"></th>
          <th class="td-afm-secondary"></th>
          <th class="td-afm-secondary td-w-20 text-center"><strong>(@group.GroupMeasure)</strong></th>
          <th class="td-afm-secondary td-w-30"></th>
        </tr>
        <tr>
          <th class="td-afm-secondary"><strong>@group.GroupCode</strong></th>
          <th class="td-afm-secondary"><strong>@group.GroupName</strong></th>
          <th class="td-afm-secondary"><strong></strong></th>
          <th class="td-afm-secondary"></th>
        </tr>

        @foreach (var item in Model.Where(x => x.IpBaseGroupId == group.Id))
        {
          <tr>
            <td></td>
            <td>@item.ItemDescription</td>
            <td>@($"{item.Value:0}")</td>
            <td>@item.Description</td>
          </tr>
        }

        @if (group.Id == 1)
        {
          decimal o = 0;
          decimal p = 0;
          try
          {
            o = Model.Where(x => x.IpBaseGroupId == group.Id && x.IpBaseItemId == 1).Select(s => s.Value).Single();
          }
          catch
          {
          }

          try
          {
            p = Model.Where(x => x.IpBaseGroupId == group.Id && x.IpBaseItemId == 2).Select(s => s.Value).Single();
          }
          catch
          {
          }

          <tr>
            <th class="td-afm-secondary"></th>
            <th class="td-afm-secondary">% Mill Utilisation</th>
            <th class="td-afm-secondary">
              @try
              {
                @($"{(p / o) * 100:0} %")
              }
              catch
              {
                @($"{0:0} %")
              }
            </th>
            <th class="td-afm-secondary"></th>
          </tr>
        }
        else
        {
          <tr>
            <th class="td-afm-secondary"></th>
            <th class="td-afm-secondary">TOTAL</th>
            <th class="td-afm-secondary">@($"{Model.Where(x => x.IpBaseGroupId == group.Id).Sum(x => x.Value):0}")</th>
            <th class="td-afm-secondary"></th>
          </tr>
        }

      </table>
    }
  </div>
</div>

@if (currentPageAction == CurrentPageAction.Manage)
{
  <div class="row g-2">
    <div class="col-12">
      <div style="float: right" class="mt-2">
        <a asp-controller="IndustryProfile" asp-action="EditIndustryProfileBaseInfo" asp-route-id="@id" class="btn btn-primary"><i class="fa fa-edit"></i> Edit</a>
      </div>
    </div>
  </div>
}