@page
@using AFMA.Stats.Client.Areas.Identity.Pages.Account
@model ResetPasswordModel

@{
  ViewData["Title"] = "Forgot Password";
  Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<style scoped>

  .font-size-28 {
    font-size: 28px !important;
  }

  .font-size-30 {
    font-size: 40px !important;
  }

</style>

<div class="account-pages my-5 pt-sm-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-10">
        <div class="text-center">
          <div class="card overflow-hidden">
            <div class="row g-0">

              <div class="col-6 p-5 p-4 align-middle">
                <div class="font-size-28 text-gray-700 fw-bold fs-6 d-grid"><strong>AFMA Statistics Portal</strong></div>
                <div class="font-size-15 text-gray-700 fw-bold fs-6 d-grid">Animal Feed Sales and related information</div>
              </div>
              <div class="col-6 p-5" style="text-align:right">
                <a href=@Url.Action("Index", "Home") class="1auth-logo">
                  <img src="~/assets/images/afma-logo-1.png" alt="" height="90">
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="card overflow-hidden">
          <div class="row g-0">

            <div class="col-lg-6">
              <div class="p-lg-5 p-4">

                <div>
                  <h5>Reset Password</h5>
                  <p class="text-muted">Reset your password here.</p>
                </div>

                <div class="mt-4">
                  <form method="post" class="need-validation" novalidate>

                    <input asp-for="Input.Code" type="hidden" />

                    <div class="mb-3">
                      <label asp-for="Input.Username" class="form-label fw-bold"></label>
                      <input asp-for="Input.Username" class="form-control" placeholder="Enter your username" autocomplete="off" autofocus="">
                      <span asp-validation-for="Input.Username" class="invalid-feedback"></span>
                    </div>
                    
                    <div class="mb-3">
                      <label asp-for="Input.Password" class="form-label"></label>
                      <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter nNew password"/>
                      <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                      <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                      <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password"/>
                      <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mt-4">
                      <button type="submit" class="w-100 btn btn-primary">Reset</button>
                    </div>

                  </form>
                </div>

              </div>
            </div>
            <div class="col-lg-6">
              <div class="p-lg-5 p-4 bg-auth h-100 d-none d-lg-block">
                <div class="bg-overlay"></div>

              </div>
            </div>
          </div>
        </div>
        <div class="mt-5 text-center">
          <p>Remember It ? <a href=@Url.Action("Index", "Home") class="fw-semibold text-decoration-underline"> Login  </a> </p>
          <p>
            Copyright © <script>document.write(new Date().getFullYear())</script> <b>Animal Feed Manufacturers Association (AFMA)</b>.<br />
            Registration Number: 1988/005169/08<br />
            Association incorporated under section 21 I 024-025-NPO
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}