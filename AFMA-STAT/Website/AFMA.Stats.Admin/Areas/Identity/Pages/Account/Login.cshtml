@page
@using AFMA.Stats.Admin.Areas.Identity.Pages.Account
@model LoginModel

@{
  ViewData["Title"] = "Log in";
}

<div class="row">
  <div class="col-6 p-3">
    <h1 class="fw-black mb-2">AFMA Statistics Portal</h1>
    <p class="fw-light text-secondary mb-4">Animal Feedsales and related information</p>
  </div>
  <div class="col-6 p-3">
    <img alt="AFMA Statistics" src="~/img/afma-logo-1.png" width="auto" height="64" class="pull-right">
  </div>
</div>

<div class="row">
  <div class="col-12">
    <form id="account" method="post">
      <div class="mb-3">
        <label asp-for="Input.Email" class="form-label fw-bold"></label>
        <input asp-for="Input.Email" class="form-control" placeholder="Enter your username or email address" autocomplete="off" autofocus="" required="">
        <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Input.Password" class="form-label fw-bold"></label>
        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" required="">
        <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
      </div>
      <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-area="Identity" asp-page="ForgotPassword" class="link-primary small text-decoration-none">Forgot your password?</a>
@*        <a href="/Identity/Account/ForgotPassword" class="link-primary small text-decoration-none">Forgot password ?</a>*@
      </div>
      <button type="submit" class="btn btn-afm-primary w-100">Sign in</button>
    </form>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
