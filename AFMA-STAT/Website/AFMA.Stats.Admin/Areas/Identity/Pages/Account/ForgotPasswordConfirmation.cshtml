@page
@using AFMA.Stats.Admin.Areas.Identity.Pages.Account
@model ForgotPasswordConfirmation
@{
  ViewData["Title"] = "Forgot Password";
}

<div class="row">
  <div class="col-6 p-3">
    <h1 class="fw-black mb-2">AFMA Statistics Portal</h1>
    <p class="fw-light text-secondary mb-4">Animal Feedsales and related information</p>
  </div>
  <div class="col-6 p-3">
    <img alt="AFMA Statistics" src="~/img/afma-logo-1.png" width="auto" height="64" class="pull-right">
  </div>
</div>

<div class="row">
  <div class="col-12">
      <div class="mb-3">
        <h4>Reset Password</h4>
      </div>
    <div class="mb-3">
      <p class="fw-light text-secondary mb-4">A link to reset your password has been sent to your email address with instructions on how to continue resetting your password.</p>
    </div>
    <div class="mb-3">
      <p class="fw-light text-secondary mb-4">Your password has not yet been changed. If you remember it you can ignore the password reset email and log in below.</p>
    </div>
    <a asp-area="Identity" asp-page="Login" class="btn btn-afm-primary w-100">Sign In</a>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}

