@page
@using AFMA.Stats.Admin.Areas.Identity.Pages.Account
@model ResetPasswordModel

@{
  ViewData["Title"] = "Reset Password";
}

<div class="row">
  <div class="col-6 p-3">
    <h1 class="fw-black mb-2">AFMA Statistics Portal</h1>
    <p class="fw-light text-secondary mb-4">Animal Feedsales and related information</p>
  </div>
  <div class="col-6 p-3">
    <img alt="AFMA Statistics" src="~/img/afma-logo-1.png" width="auto" height="64" class="pull-right">
  </div>
</div>

<div class="row">
  <div class="col-12">
    <form id="account" method="post">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <input asp-for="Input.Code" type="hidden" />
      <div class="mb-3">
        <label asp-for="Input.Username" class="form-label fw-bold"></label>
        <input asp-for="Input.Username" class="form-control" placeholder="Enter your username" autocomplete="off" autofocus="" required="">
        <span asp-validation-for="Input.Username" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Input.Password" class="form-label fw-bold"></label>
        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" required="">
        <span asp-validation-for="Input.Username" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold"></label>
        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Enter your password" required="">
        <span asp-validation-for="Input.Username" class="text-danger"></span>
      </div>

      <div class="mb-3 d-flex justify-content-between align-items-center">
      </div>
      <button type="submit" class="btn btn-afm-primary w-100">Reset Password</button>
    </form>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
