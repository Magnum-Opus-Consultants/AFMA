@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<AFMA.ApplicationLayer.Model.ProductModel>

@{
  var filterProductGroupId = Context.Request.Query["filterProductGroupId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item active" aria-current="page">Finished Products</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Finished Products</h4>
    </div>

    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">
          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Raw Material Category</label>
              <select id="filterProductGroupId" name="filterProductGroupId" class="form-control" asp-items="@await ApplicationLayer.GenerateProductGroupSelectList(filterProductGroupId)">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Search</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search names..." value="@filterSearchText" />
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br />
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="col-12 pb-3">
      <a asp-controller="FinishedProduct" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Finished Product</a>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col" class="w-5">Code</th>
          <th scope="col" class="w-25">Group</th>
          <th scope="col">Name</th>
          <th scope="col" class="w-5 text-center">Visible</th>
          <th scope="col" class="w-5 text-center">Status</th>
          <th class="w-5"></th>
        </tr>
        </thead>
        <tbody>
          @foreach (var product in Model)
          {
            <tr>
              <td class="align-middle">
                @product.Code
              </td>
              <td class="align-middle">
                @product.ProductGroup
              </td>
              <td class="align-middle">
                @product.Name
              </td>
              <td class="align-middle text-center">
                @Html.Raw(product.VisibleToMembers.ToFormattedYesNo("info", "warning"))
              </td>
              <td class="align-middle text-center">
                @Html.Raw(product.Active.ToFormattedActiveInactive())
              </td>
              <td class="text-center">
                <a asp-area="General" asp-action="Details" asp-controller="FinishedProduct" asp-route-id="@product.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page,filterProductGroupId,  filterSearchText }))
    </div>
  </div>

</div>