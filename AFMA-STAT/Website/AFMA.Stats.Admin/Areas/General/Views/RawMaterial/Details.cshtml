@using AFMA.ApplicationLayer.Model
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model AFMA.ApplicationLayer.Model.MaterialModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item"><a href="#">Raw Materials</a></li>
    <li class="breadcrumb-item active" aria-current="page">View Raw Material</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>View Raw Material</h4>
    </div>

    <div class="row g-2">

      <div class="col-2">
        <div class="form-group">
          <label asp-for="Code" class="form-label"></label>
          <input asp-for="Code" class="form-control" readonly />
        </div>
      </div>

      <div class="col-10">
        <div class="form-group">
          <label asp-for="Name" class="form-label"></label>
          <input asp-for="Name" class="form-control" readonly />
        </div>
      </div>

      <div class="col-12">
        <div class="form-group">
          <label asp-for="MaterialCategory" class="form-label"></label>
          <input asp-for="MaterialCategory" class="form-control" readonly />
        </div>
      </div>

      <div class="col-6">
        <div class="form-group">
          <label asp-for="SalmonellaReportGroup" class="form-label"></label>
          <input asp-for="SalmonellaReportGroup" class="form-control" readonly />
        </div>
      </div>

      <div class="col-6">
        <div class="form-group">
          <label asp-for="FeedsalesReportGroup" class="form-label"></label>
          <input asp-for="FeedsalesReportGroup" class="form-control" readonly />
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="ShowAlert" class="form-check-input" type="checkbox" disabled="">
          <label asp-for="ShowAlert" class="form-check-label">Show Alert Message</label>
        </div>
      </div>

      @if (Model.ShowAlert)
      {
        <div class="col-12">
          <div class="form-group">
            <label asp-for="AlertMessage" class="form-label"></label>
            <textarea asp-for="AlertMessage" rows="2" class="form-control" disabled=""></textarea>
          </div>
        </div>
      }

      <div class="col-12">
        <div class="form-check">
          <input asp-for="Active" class="form-check-input" type="checkbox" disabled>
          <label asp-for="Active" class="form-check-label">Active</label>
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="VisibleToMembers" class="form-check-input" type="checkbox" disabled>
          <label asp-for="VisibleToMembers" class="form-check-label">Visible To Members</label>
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="HideOnFeedsales" class="form-check-input" type="checkbox" disabled>
          <label asp-for="HideOnFeedsales" class="form-check-label">Hidden In Feedsales</label>
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="HideOnSalmonella" class="form-check-input" type="checkbox" disabled>
          <label asp-for="HideOnSalmonella" class="form-check-label">Hidden In Salmonella</label>
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="Other" class="form-check-input" type="checkbox" disabled>
          <label asp-for="Other" class="form-check-label">Requires Other Description</label>
        </div>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input asp-for="AllowDuplicates" class="form-check-input" type="checkbox" disabled>
          <label asp-for="AllowDuplicates" class="form-check-label">Allow Duplicate Submissions</label>
        </div>
      </div>
    </div>

    <div class="row g-2 mt-2">
      <div class="col-12">
        <div class="alert alert-info">
          <p>Options explanation:</p>
          <ul>
            <li><strong>REQUIRES OTHER DESCRIPTION</strong> - When this option is enabled, the user will be asked to enter more information about the submission. Typically used when an OTHER or generic product name is selected.</li>
            <li><strong>ALLOW DUPLICATE SUBMISSIONS</strong> - Normally a product or material can only be added to a report once. Enabling this option will allow the user to add this product or material more than once on a single report.</li>
            <li><strong>SHOW ALERT</strong> - When this option is selected, the alert message text will be shown to the member whenever he/she adds this material to a report.</li>
          </ul>
        </div>
      </div>
    </div>

    <div style="float: left" class="mt-4">
      <a asp-area="General" asp-controller="RawMaterial" asp-action="Index" class="btn btn-light"><i class="fa-solid fa-arrow-left"></i> Back</a>
    </div>

    <div style="float: right" class="mt-4">
      <a asp-area="General" asp-controller="RawMaterial" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
      <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteRawMaterialConfirm"><i class="fa-solid fa-trash"></i> Delete</button>
    </div>

  </div>
</div>

<partial name="DeleteRawMaterialConfirmPartial" model="@(new NotificationModel{Id = Model.Id})" />