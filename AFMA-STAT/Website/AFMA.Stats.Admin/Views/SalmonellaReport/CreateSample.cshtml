@using AFMA.ApplicationLayer.Interface
@inject IApplicationLayer ApplicationLayer
@inject ISalmonellaLayer SalmonellaLayer

@model AFMA.ApplicationLayer.Model.SalmonellaSampleModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Salmonella Reports</a></li>
    <li class="breadcrumb-item active" aria-current="page">Create Sample</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>New Salmonella Sample</h4>
    </div>

    <form class="needs-validation" novalidate asp-action="CreateSample" method="post">
      <input type="hidden" asp-for="Id" class="form-control" value="0" />
      <input type="hidden" asp-for="SalmonellaReportId" class="form-control" />

      <div class="row g-2">
        <div class="col-12 mb-2">
          <div class="form-group">
            <label asp-for="SalmonellaSampleTypeId" class="form-label"></label>
            <select class="form-control" asp-for="SalmonellaSampleTypeId" asp-items="@(await ApplicationLayer.GenerateSalmonellaSampleTypeSelectList(null))" required>
              <option value="">-- Select Sample Type --</option>
            </select>
            <div class="invalid-feedback">Sample Type is required.</div>
          </div>
        </div>

        <div id="rawMaterial" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="MaterialId" class="form-label"></label>
              <select class="form-control" asp-for="MaterialId" asp-items="@(await SalmonellaLayer.GenerateMaterialSelectList(null))" required>
                <option value="">-- Select Raw Material --</option>
              </select>
              <div class="invalid-feedback">Raw Material is required.</div>
            </div>
          </div>
        </div>

        <div id="finishedProduct" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="ProductId" class="form-label"></label>
              <select class="form-control" asp-for="ProductGroupId" asp-items="@(await SalmonellaLayer.GenerateProductGroupSelectList(null))" required>
                <option value="">-- Select Finished Product Group --</option>
              </select>
              <div class="invalid-feedback">Finished Product is required.</div>
            </div>
          </div>
        </div>

        <div id="dustSwab" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="SalmonellaSampleTypeItemId" class="form-label"></label>
              <select class="form-control" asp-for="SalmonellaSampleTypeItemId" asp-items="@(await ApplicationLayer.GenerateSalmonellaSampleTypeItemSelectList(null))" required>
                <option value="">-- Select Main Location --</option>
              </select>
              <div class="invalid-feedback">Main Location is required.</div>
            </div>
          </div>
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="SalmonellaSampleTypeSubItemId" class="form-label"></label>
              <select class="form-control" asp-for="SalmonellaSampleTypeSubItemId" asp-items="@(await ApplicationLayer.GenerateSalmonellaSampleTypeSubItemSelectList(null))" required>
                <option value="">-- Select Sub Location --</option>
              </select>
              <div class="invalid-feedback">Sub Location is required.</div>
            </div>
          </div>
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="AdditionalInfo" class="form-label"></label>
              <textarea asp-for="AdditionalInfo" rows="3" class="form-control"></textarea>
            </div>
          </div>
        </div>

        <div class="col-12 mb-2">
          <div class="form-check">
            <input asp-for="SalmonellaDetected" class="form-check-input" type="checkbox">
            <label asp-for="SalmonellaDetected" class="form-check-label">Salmonella Detected</label>
          </div>
        </div>

        <div id="salmonellaType" style="display: none">
          <div class="col-12 mb-2">
            <div class="form-group">
              <label asp-for="SalmonellaTypeId" class="form-label"></label>
              <select class="form-control" asp-for="SalmonellaTypeId" asp-items="@(await SalmonellaLayer.GenerateSalmonellaTypeSelectList(null))" required>
              </select>
              <div class="invalid-feedback">Salmonella Type is required.</div>
            </div>
          </div>
        </div>

        <div class="col-12 mb-2">
          <div class="form-group">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" rows="3" class="form-control"></textarea>
          </div>
        </div>
      </div>

      <div class="mt-2 float-md-end">
        <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
        <a asp-area="" asp-controller="SalmonellaReport" asp-action="Details" asp-route-id="@Model.SalmonellaReportId" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
      </div>

    </form>
  </div>
</div>

<script type="text/javascript">

  $('#SalmonellaDetected').change(function () {
    var state = $(this).prop('checked');
    if (state === false) {
      $("#salmonellaType").hide();
    }
    else {
      $("#salmonellaType").show();
    }
  })


  $("#SalmonellaSampleTypeId").on('change', function (e) {
    var optionSelected = $("option:selected", this);
    var valueSelected = this.value;

    switch (valueSelected) {
      case "1": //raw materials
        $("#MaterialId").attr("required");
        $("#ProductGroupId").removeAttr("required");
        $("#SalmonellaSampleTypeItemId").removeAttr("required");
        $("#SalmonellaSampleTypeSubItemId").removeAttr("required");
        $("#rawMaterial").show();
        $("#finishedProduct").hide();
        $("#dustSwab").hide();
        $("#salmonellaDetected").show();
        break;

      case "2": //finished product
        $("#ProductGroupId").attr("required");
        $("#MaterialId").removeAttr("required");
        $("#SalmonellaSampleTypeItemId").removeAttr("required");
        $("#SalmonellaSampleTypeSubItemId").removeAttr("required");
        $("#rawMaterial").hide();
        $("#finishedProduct").show();
        $("#dustSwab").hide();
        $("#salmonellaDetected").show();
        break;

      case "3": //dust swab
        $("#SalmonellaSampleTypeItemId").attr("required");
        $("#SalmonellaSampleTypeSubItemId").attr("required");
        $("#ProductGroupId").removeAttr("required");
        $("#MaterialId").removeAttr("required");
        $("#rawMaterial").hide();
        $("#finishedProduct").hide();
        $("#dustSwab").show();
        $("#salmonellaDetected").show();
        break;

      default:
        $("#rawMaterial").hide();
        $("#finishedProduct").hide();
        $("#dustSwab").hide();
        $("#salmonellaDetected").hide();
    }

  });


</script>