@using Resolvetech.NetCore.Common.Helpers
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using X.PagedList
@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.MemberSummaryModel>

<link href="/css/PagedList.css" rel="stylesheet" type="text/css" />

@{
  var filterMemberTypeId = Context.Request.Query["filterMemberTypeId"].ToNullableInt();
  var filterSearchText = Context.Request.Query["filterSearchText"];
}

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Members</h4>
    </div>

    <div class="col-12 pb-3">
      <a asp-controller="Member" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Member</a>
    </div>

    <div class="alert alert-dark">
      <form asp-action="Index" method="get">
        <div class="row g-2">

          <div class="col-4">
            <div class="form-group">
              <label class="form-label">Member Name</label>
              <input type="text" class="form-control" id="filterSearchText" name="filterSearchText" placeholder="Search member names..." value="@filterSearchText"/>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Member Type</label>
              <select id="filterMemberTypeId" name="filterMemberTypeId" class="form-control" asp-items="@await ApplicationLayer.GenerateMemberTypeSelectList(filterMemberTypeId)">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br/>
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
          <tr>
            <th scope="col" class="w-5">Member Id</th>
            <th scope="col" class="w-50">Member Name</th>
            <th scope="col">Member Type</th>
            <th scope="col" class="w-5">Branches</th>
            <th scope="col" class="w-5 text-center">Status</th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var member in Model)
          {
            <tr>
              <td class="align-middle">
                @member.MemberId
              </td>
              <td class="align-middle">
                @member.Name
              </td>
              <td class="align-middle">
                @member.MemberType
              </td>
              <td class="align-middle">
                @member.Branches?.Count
              </td>
              <td class="align-middle text-center">
                @Html.Raw(member.Active.ToFormattedActiveInactive())
              </td>
              <td class="text-center">
                <a asp-action="Details" asp-controller="Member" asp-route-id="@member.Id" class="btn btn-secondary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
      @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, filterMemberTypeId, filterSearchText }))

    </div>
  </div>
</div>