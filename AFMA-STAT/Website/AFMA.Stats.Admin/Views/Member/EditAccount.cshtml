@using AFMA.ApplicationLayer.Helpers
@model AFMA.ApplicationLayer.Model.MemberAccountModel

@{
  var fs = ApplicationLayer.CheckMemberAccountModule(Model.Id, ModuleEnum.Feedsales).Result;
  var fss = fs ? "checked" : "";
  var sm = ApplicationLayer.CheckMemberAccountModule(Model.Id, ModuleEnum.Salmonella).Result;
  var smm = sm ? "checked" : "";
  var ip = ApplicationLayer.CheckMemberAccountModule(Model.Id, ModuleEnum.IndustryProfile).Result;
  var ipp = ip ? "checked" : "";
  var mt = ApplicationLayer.CheckMemberAccountModule(Model.Id, ModuleEnum.Mycotoxin).Result;
  var mtt = mt ? "checked" : "";
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Members</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Account</li>
  </ol>
</nav>

<form class="needs-validation" novalidate asp-action="EditAccount" method="post">
  <div class="row">
    <div class="col-9">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <h4>Edit Account</h4>
          </div>

          <input type="hidden" asp-for="MemberId" />
          <input type="hidden" asp-for="UserId" />

          <div class="row g-2">

            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" required readonly />
                <div class="invalid-feedback">Username is required.</div>
              </div>
            </div>

            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" required />
                <div class="invalid-feedback">First Name is required.</div>
              </div>
            </div>

            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" required />
                <div class="invalid-feedback">Last Name is required.</div>
              </div>
            </div>

            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" required />
                <div class="invalid-feedback">Email is required.</div>
              </div>
            </div>

            <div class="col-12 mt-2">
              <div class="form-group">
                <label asp-for="MemberBranchId" class="form-label"></label>
                <select class="form-control" asp-for="MemberBranchId" asp-items="@await ApplicationLayer.GenerateMemberBranchSelectList(true, Model.MemberId, Model.MemberBranchId)" required></select>
                <div class="invalid-feedback">Branch is required.</div>
              </div>
            </div>
          </div>

          <div class="col-12 mt-3">
            <div style="float: right">
              <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
              <a asp-controller="Member" asp-action="AccountDetails" asp-route-id="@Model.Id" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="row g-2">
        <div class="card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <h4>Permissions</h4>
            </div>
            <div class="col-12 mt-2">
              <div class="form-check">
                <input asp-for="Active" class="form-check-input" type="checkbox" checked>
                <label asp-for="Active" class="form-check-label">Active</label>
              </div>
            </div>
            <div class="col-12 mt-2">
              <div class="form-check">
                <input asp-for="IsAdministrator" class="form-check-input" type="checkbox">
                <label asp-for="IsAdministrator" class="form-check-label">Is Administrator</label>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <h4>Modules</h4>
            </div>

            @if (await ApplicationLayer.CheckMemberModule(Model.MemberId, ModuleEnum.Feedsales))
            {
              <div class="col-12 mt-2">
                <div class="form-check">
                  @if (fs)
                  {
                    <input asp-for="FeedsalesAccess" class="form-check-input" type="checkbox" checked>
                  }
                  else
                  {
                    <input asp-for="FeedsalesAccess" class="form-check-input" type="checkbox" )>
                  }
                  <label asp-for="FeedsalesAccess" class="form-check-label">Access Feedsales Module</label>
                </div>
              </div>
            }

            @if (await ApplicationLayer.CheckMemberModule(Model.MemberId, ModuleEnum.Salmonella))
            {
              <div class="col-12 mt-2">
                <div class="form-check">
                  @if (sm)
                  {
                    <input asp-for="SalmonellaAccess" class="form-check-input" type="checkbox" checked>
                  }
                  else
                  {
                    <input asp-for="SalmonellaAccess" class="form-check-input" type="checkbox">
                  }
                  <label asp-for="SalmonellaAccess" class="form-check-label">Access Salmonella Module</label>
                </div>
              </div>
            }

            @if (await ApplicationLayer.CheckMemberModule(Model.MemberId, ModuleEnum.IndustryProfile))
            {
              <div class="col-12 mt-2">
                <div class="form-check">
                  @if (ip)
                  {
                    <input asp-for="IndustryProfileAccess" class="form-check-input" type="checkbox" checked>
                  }
                  else
                  {
                    <input asp-for="IndustryProfileAccess" class="form-check-input" type="checkbox">
                  }
                  <label asp-for="IndustryProfileAccess" class="form-check-label">Access Industry Profile Module</label>
                </div>
              </div>
            }

            @if (await ApplicationLayer.CheckMemberModule(Model.MemberId, ModuleEnum.Mycotoxin))
            {
              <div class="col-12 mt-2">
                <div class="form-check">
                  @if (mt)
                  {
                    <input asp-for="MycotoxinsAccess" class="form-check-input" type="checkbox" checked>
                  }
                  else
                  {
                    <input asp-for="MycotoxinsAccess" class="form-check-input" type="checkbox">
                  }
                  <label asp-for="MycotoxinsAccess" class="form-check-label">Access Mycotoxins Module</label>
                </div>
              </div>
            }

          </div>
        </div>
      </div>
    </div>
  </div>
</form>