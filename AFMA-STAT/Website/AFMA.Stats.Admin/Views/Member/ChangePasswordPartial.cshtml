@model AFMA.ApplicationLayer.Model.NotificationModel

<div class="modal fade" id="changeAccountPassword" tabindex="-1" aria-labelledby="changeAccountPasswordLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Change Account Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="needs-validation" novalidate asp-route-userId="@Model.UserId" asp-route-memberAccountId="@Model.MemberAccountId" asp-controller="Member" asp-action="ChangeAccountPassword" method="post">
          <div class="row g-2">
            <div class="col-12 mt-2">
              <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="text" id="Password" name="password" class="form-control" required />
                <div class="invalid-feedback">Password is required.</div>
              </div>
            </div>
          </div>

          <div class="row g-2 mt-1">
            <div class="col-12">
              <p class="text-success">Please note that the password will be emailed to the user!!</p>
            </div>
          </div>
          
          <div class="row g-2">
            <div class="col-12">
              <div class="alert alert-info">
                <p>Password requirements:</p>
                <ul>
                  <li>Password must be 8 characters or more.</li>
                  <li>Must contain at least 1 uppercase and 1 lowercase character.</li>
                  <li>Must contain at least 1 number.</li>
                  <li>Must contain at least 1 special character, e.g. $, * or &.</li>
                  <li>Must not contain any spaces.</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="row mt-2 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Continue</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>