@model AFMA.ApplicationLayer.Model.NotificationModel

<div class="modal fade" id="deleteMemberConfirm" tabindex="-1" aria-labelledby="deleteMemberConfirmLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Delete Member</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-userId="@Model.UserId" asp-route-memberId="@Model.MemberId" asp-controller="Member" asp-action="DeleteMember" method="post">
          <div class="row">
            <div class="col-12">
              <p>Confirm that this member is to be deleted.</p>
              <p>NOTE! All related information like branches, accounts and all submission history will be deleted.</p>
            </div>
          </div>
          <div class="row mt-2 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>