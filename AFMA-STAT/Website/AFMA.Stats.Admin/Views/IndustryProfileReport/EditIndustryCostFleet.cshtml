@model AFMA.ApplicationLayer.ViewModels.CompanyIndustryProfileViewModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Industry Profile</a></li>
    <li class="breadcrumb-item active" aria-current="page">Industry Profile Reports</li>
  </ol>
</nav>

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="mb-3">Edit Rented Fleet (Total Cost)</h4>
        </div>

        <form class="needs-validation" novalidate asp-action="EditIndustryCostFleet" method="post">
          <input asp-for="IndustryProfileReportId" type="hidden" />
          <input asp-for="MemberId" type="hidden" />
          <input asp-for="MemberBranchId" type="hidden" />
          <input asp-for="MemberTypeId" type="hidden" />


          <div class="row">
            <div class="col-md-12">

              <table class="table table-responsive table-striped table-condensed table-bordered">
                <tr>
                  <th class="td-afm-secondary td-w-5">Code</th>
                  <th class="td-afm-secondary">Item</th>
                  <th class="td-afm-secondary td-w-20">Note</th>
                  <th class="td-afm-secondary td-w-10">Total Cost</th>
                </tr>

                @foreach (var item in Model.MemberRunningCostsFleet)
                {
                  <tr>
                    <td class="align-middle">@item.RunningCostRentedFleetCode</td>
                    <td class="align-middle">@item.ItemDescription</td>
                    <td class="align-middle">@item.Note</td>
                    <td>
                      <input type="number" id="RunningCostRentalFleet_@item.Id" name="RunningCostRentalFleet_@item.Id" class="form-control" value="@item.Value" />
                    </td>
                  </tr>
                }
              </table>
            </div>
          </div>

          <div style="float: right">
            <button type="submit" class="btn btn-afm-default"><i class="fa-solid fa-save"></i> Save</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
