@using AFMA.ApplicationLayer.Helpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model AFMA.ApplicationLayer.Model.MycotoxinSampleModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Mycotoxins</a></li>
    <li class="breadcrumb-item"><a href="#">Mycotoxins Reports</a></li>
    <li class="breadcrumb-item active" aria-current="page">Mycotoxin Sample Details</li>
  </ol>
</nav>

<div class="row g-2">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="mb-2">Mycotoxin Sample Details</h4>
        </div>
        <div class="row mt-2">
          <div class="col-6">
            <div class="form-group">
              <label asp-for="Id" class="form-label"></label>
              <input asp-for="Id" class="form-control" disabled />
            </div>
          </div>

          <div class="col-6">
            <div class="form-group">
              <label asp-for="MycotoxinReportId" class="form-label"></label>
              <input asp-for="MycotoxinReportId" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div class="row mt-2">
          <div class="col-6">
            <div class="form-group">
              <label asp-for="MycotoxinSampleType" class="form-label"></label>
              <input asp-for="MycotoxinSampleType" class="form-control" disabled />
            </div>
          </div>
        </div>

        @if (Model.MycotoxinSampleTypeId == (int)MycotoxinSampleTypeEnum.RawMaterial)
        {
          <div class="row mt-2">
            <div class="col-6">
              <div class="form-group">
                <label asp-for="Material" class="form-label"></label>
                <input asp-for="Material" class="form-control" disabled />
              </div>
            </div>

            <div class="col-6">
              <div class="form-group">
                <label asp-for="MaterialOrigin" class="form-label"></label>
                <input asp-for="MaterialOrigin" class="form-control" disabled />
              </div>
            </div>
          </div>

          <div class="row mt-2">
            @if (Model.MaterialOriginId == (int)MaterialOriginEnum.Local)
            {
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="Province" class="form-label"></label>
                  <input asp-for="Province" class="form-control" disabled />
                </div>
              </div>
            }

            @if (Model.MaterialOriginId == (int)MaterialOriginEnum.Imported)
            {
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="MaterialCountryOfOrigin" class="form-label"></label>
                  <input asp-for="MaterialCountryOfOrigin" class="form-control" disabled />
                </div>
              </div>
            }
          </div>
        }

        @if (Model.MycotoxinSampleTypeId == (int)MycotoxinSampleTypeEnum.FinishedProduct)
        {
          <div class="row mt-2">
            <div class="col-6">
              <div class="form-group">
                <label asp-for="Product" class="form-label"></label>
                <input asp-for="Product" class="form-control" disabled />
              </div>
            </div>
          </div>
        }

        <div class="row mt-2">
          <div class="row mt-2">
            <div class="col-6">
              <div class="form-group">
                <label asp-for="MycotoxinAnalysis" class="form-label"></label>
                <input asp-for="MycotoxinAnalysis" class="form-control" disabled />
              </div>
            </div>
            @if (MycotoxinLayer.GetMycotoxinAnalysisMethod(Model.MycotoxinAnalysisId).Result.Other)
            {
              <div class="col-6">
                <div class="form-group">
                  <label asp-for="MycotoxinAnalysisOther" class="form-label"></label>
                  <input asp-for="MycotoxinAnalysisOther" class="form-control" disabled />
                </div>
              </div>
            }
          </div>
        </div>

        <div class="row mt-2">
          <div class="col-12">
            <div class="form-group">
              <label asp-for="Note" class="form-label"></label>
              <input asp-for="Note" class="form-control" disabled />
            </div>
          </div>
        </div>

        <div style="float: left" class="mt-2">
          <a asp-controller="MycotoxinReport" asp-action="Index" class="btn btn-outline-default"><i class="fa-solid fa-arrow-left"></i> Back</a>
        </div>

        <div style="float: right" class="mt-2">
          <a asp-controller="MycotoxinReport" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-afm-primary"><i class="fa-solid fa-edit"></i> Edit</a>
          <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteMycotoxinSample"><i class="fa-solid fa-trash"></i> Delete</button>
        </div>
      </div>
    </div>
  </div>
</div>