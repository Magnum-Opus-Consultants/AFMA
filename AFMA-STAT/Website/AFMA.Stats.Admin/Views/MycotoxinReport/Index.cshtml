@using Resolvetech.NetCore.Common.Helpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using AFMA.ApplicationLayer.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.MycotoxinReportLookupModel>

@{
  var filterMemberBranchId = Context.Request.Query["filterMemberBranchId"].ToNullableInt();
  var filterMemberId = Context.Request.Query["filterMemberId"].ToNullableInt();
  var filterIsSubmitted = Context.Request.Query["filterIsSubmitted"].ToNullableBool();
}

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">Mycotoxins</a></li>
    <li class="breadcrumb-item active" aria-current="page">Submit Reports</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Submit Mycootoxin Reports</h4>
    </div>

    <div class="alert alert-dark">
      <form asp-action="Index" method="get">

        <div class="row g-2">
          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Report Status</label>
              <select id="filterIsSubmitted" name="filterIsSubmitted" class="form-control" asp-items="@(ApplicationLayer.GenerateReportStatusSelectList(filterIsSubmitted))">
                <option value="">All</option>
              </select>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Member</label>
              <select id="filterMemberId" name="filterMemberId" class="form-control" asp-items="@(await ApplicationLayer.GenerateMemberSelectList(true, ModuleEnum.Mycotoxin, filterMemberId))">
                <option value="">-- Select Member --</option>
              </select>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">Branch</label>
              <select id="filterMemberBranchId" name="filterMemberBranchId" class="form-control" asp-items="@(await ApplicationLayer.GenerateMemberBranchSelectList(true, filterMemberId, filterMemberBranchId))">
                <option value="">-- Select Branch --</option>
              </select>
            </div>
          </div>

          <div class="col-2">
            <div class="form-group">
              <label class="form-label">&nbsp;</label><br />
              <button type="submit" class="btn btn-afm-secondary"><i class="fa-solid fa-refresh"></i> Refresh</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
          <tr>
            <th scope="col" class="w-10">Info For</th>
            <th scope="col" class="w-10">Report No</th>
            <th scope="col" class="w-25">Member</th>
            <th scope="col" class="w-25">Branch</th>
            <th scope="col" class="w-5 text-center">Status</th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var report in Model)
          {
            <tr>
              <td class="align-middle">
                @report.InfoFor.ToString("yyyy/MM") (@report.InfoFor.ToString("MMMM yyyy"))
              </td>
              <td class="align-middle">
                @report.Id
              </td>
              <td class="align-middle">
                @report.Member
              </td>
              <td class="align-middle">
                @report.MemberBranch
              </td>
              <td class="align-middle text-center">
                @Html.Raw(report.IsSubmitted.ToCustomFormattedTrueFalse("success","Submitted","danger","Outstanding"))
              </td>
              <td class="text-center">
                <a asp-action="Details" asp-controller="MycotoxinReport" asp-route-id="@report.Id" class="btn btn-secondary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
                <a asp-action="Edit" asp-controller="MycotoxinReport" asp-route-id="@report.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-edit"></i> Edit</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>

  $(function () {

      $("select#filterMemberId").change(function () {
          var mid = $(this).val();
          $("select#filterMemberBranchId").empty();

          $.getJSON(`/Member/GetMemberBranches?memberId=${mid}`,
              function (data) {
                  $("select#filterMemberBranchId").append(`<option value="">-- All Branches --</option>`);
                  $.each(data,
                      function (i, item) {
                          $("select#filterMemberBranchId").append(`<option value="${item.id}">${item.name}</option>`);
                      });
              });
      });
  });

</script>