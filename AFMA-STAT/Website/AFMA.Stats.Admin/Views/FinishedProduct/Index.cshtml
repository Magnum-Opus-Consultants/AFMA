@using Resolvetech.NetCore.Common.Helpers
@model IEnumerable<AFMA.ApplicationLayer.Model.ProductGroupModel>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Finished Products</h4>
    </div>

    <div class="col-12 pb-3">
      <a asp-controller="FinishedProduct" asp-action="Create" class="btn btn-afm-primary"><i class="fa-solid fa-plus"></i> New Finished Product</a>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-sm table-bordered">
        <thead>
        <tr>
          <th scope="col" class="w-10">Code</th>
          <th scope="col">Name</th>
          <th scope="col" class="w-5 text-center">Products</th>
          <th scope="col" class="w-5 text-center">Visible</th>
          <th scope="col" class="w-5 text-center">Status</th>

          <th class="w-10"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
          <tr>
            <td class="align-middle">
              @product.Code
            </td>
            <td class="align-middle">
              @product.Name
            </td>
            <td class="align-middle text-center">
              @product.Products?.Count()
            </td>
            <td class="align-middle text-center">
              @Html.Raw(product.VisibleToMembers.ToFormattedYesNo())
            </td>
            <td class="align-middle text-center">
              @Html.Raw(product.Active.ToFormattedActiveInactive())
            </td>
            <td class="text-center">
              <a asp-action="Details" asp-controller="FinishedProduct" asp-route-id="@product.Id" class="btn btn-afm-primary btn-sm"><i class="fa-regular fa-eye"></i> View</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>

</div>