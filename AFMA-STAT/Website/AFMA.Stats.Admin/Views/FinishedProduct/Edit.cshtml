@model AFMA.ApplicationLayer.Model.ProductGroupModel

<nav aria-label="breadcrumb" id="main-breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="#">Home</a></li>
    <li class="breadcrumb-item"><a href="#">General</a></li>
    <li class="breadcrumb-item"><a href="#">Finished Products</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Finished Product</li>
  </ol>
</nav>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h4>Edit Finished Product</h4>
    </div>
    
    <form class="needs-validation" novalidate asp-action="Create" method="post">
      <div class="row g-2">
        
        <div class="col-2">
          <div class="form-group">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
          </div>
        </div>

        <div class="col-10">
          <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required/>
            <div class="invalid-feedback">Name is required.</div>
          </div>
        </div>

        <div class="col-12">
          <div class="form-group">
            <label asp-for="SalmonellaProductGroupCategoryId" class="form-label"></label>
            <select class="form-control">
              <option value="1">Dairy, Beef and Sheep</option>
            </select>
          </div>        
        </div>

        <div class="col-12">
          <div class="form-check">
            <input asp-for="Active" class="form-check-input" type="checkbox" checked>
            <label asp-for="Active" class="form-check-label">Active</label>
          </div>        
        </div>
        
        <div class="col-12">
          <div class="form-check">
            <input asp-for="VisibleToMembers" class="form-check-input" type="checkbox" checked>
            <label asp-for="VisibleToMembers" class="form-check-label">Visible To Members</label>
          </div>        
        </div>
        
        <div class="col-12">
          <div class="form-check">
            <input asp-for="HideOnFeedsales" class="form-check-input" type="checkbox">
            <label asp-for="HideOnFeedsales" class="form-check-label">Hidden In Feedsales</label>
          </div>        
        </div>
        
        <div class="col-12">
          <div class="form-check">
            <input asp-for="HideOnSalmonella" class="form-check-input" type="checkbox">
            <label asp-for="HideOnSalmonella" class="form-check-label">Hidden In Salmonella</label>
          </div>        
        </div>
      </div>
      
      <div style="float: right">
        <button type="submit" class="btn btn-afm-default"><i class="fa-regular fa-save"></i> Save</button>
        <a asp-controller="FinishedProduct" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default"><i class="fa-solid fa-xmark"></i> Cancel</a> 
      </div>
    </form>
  </div>
</div>