@model int

<div class="modal fade" id="deleteFeedsalesReportItem" tabindex="-1" aria-labelledby="deleteFeedsalesReportItemLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title h4">Delete Feedsales Report Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-route-feedsalesReportId="@Model" asp-action="DeleteFeedsalesReportItem" method="post">
          <div class="row">
            <div class="col-12">
              <input type="hidden" id="TReportItemId" name="TReportItemId" />
              <input type="hidden" id="TReportItemType" name="TReportItemType" />
              <p>Are you sure you want to delete this Feedsales Report item?</p>
              <p>This action cannot be reversed!</p>
            </div>
          </div>
          <div class="row mt-2 pull-right">
            <div class="col-12">
              <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>