{
  "ConnectionStrings": {
    "ApplicationRepository": "Server=(local);Database=afmastats;Integrated Security=true;User ID=;Password=;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "WimsApplicationRepository": "Server=(local);Database=afmaweb;Integrated Security=true;User ID=;Password=;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": {
      "MSSqlServer": {
        "Name": "MSSqlServer",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "connectionString": "ApplicationRepository",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "Source",
                "PropertyName": "SourceContext",
                "DataType": "varchar",
                "DataLength": 200
              }
            ],
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "logEvent": {
              "excludeAdditionalProperties": true,
              "excludeStandardColumns": true
            }
          }
        }
      }
    }
  },
  "ApplicationSettings": {
    "Deployment": "Not Deployed",
    "BaseUrl": "https://localhost:44365",
    "ClientUrl": "https://localhost:44365",
    "PageSize": "25",
    "CachMinutes": "1440",
    "Version": "1.0.XXX",
    "TestSite": false
  },
  "SMTPSettings": {
    "Host": "",
    "Port": "",
    "Username": "",
    "Password": "",
    "FromName": "AFMA",
    "FromAddress": "system@afmastats.co.za",
    "Auth": "false",
    "Debug": "true",
    "DebugEmail": "stats@afma.co.za",
    "SubmissionStatsEmail": "stats@afma.co.za"
  },
  "EPPlus": {
    "ExcelPackage": {
      "LicenseContext": "NonCommercial"
    }
  },
  "AllowedHosts": "*",
  "MaintenanceSettings": {
    "Enabled": false,
    "Heading": "AFMA Stats System Temporarily Unavailable",
    "Message": "Please note that the AFMA Stats System is temporarily unavailable.\n\nWe sincerely apologise for any inconvenience caused and appreciate your patience during this period.\n\nFor any assistance or further information regarding the submission of monthly figures, please contact the AFMA office on +27 (0) 12 663 9097 or email petru@afma.co.za.",
    "BypassToken": "",
    "BypassCookieName": "afma_maintenance_bypass",
    "BypassQueryParameter": "preview",
    "BypassCookieDays": 7,
    "RetryAfterSeconds": 3600
  }
}